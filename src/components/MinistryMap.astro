---
// Ministries plotted on a real Grand Rapids basemap.
//
// The basemaps are a few shared frames rendered ahead of time by
// scripts/build-ministry-maps.py. This picks the tightest frame that holds the
// pins it was given, then projects them with the same Web Mercator maths, so
// every category can have its own map without needing its own image.
//
// Distance from our building is deliberately absent: people travel from home,
// not from Knapp's Corner, so the useful label is the area a ministry sits in.
import mapData from "../../content/ministry-maps.json";
import type { Entry } from "../data/ministries";

interface Props {
	entries: Entry[];
	label?: string;
}

const { entries, label } = Astro.props;

type Frame = { name: string; src: string; lat: number; lng: number; zoom: number; w: number; h: number };
const frames = (mapData as { frames: Frame[] }).frames;

const CHURCH = { lat: 42.999923, lng: -85.601454 };

function project(lat: number, lng: number, zoom: number) {
	const world = 512 * 2 ** zoom;
	const x = ((lng + 180) / 360) * world;
	const s = Math.sin((lat * Math.PI) / 180);
	const y = (0.5 - Math.log((1 + s) / (1 - s)) / (4 * Math.PI)) * world;
	return { x, y };
}

const located = entries.filter(
	(e) => e.house === "out" && typeof e.lat === "number" && typeof e.lng === "number",
);
const unlocated = entries.filter((e) => e.house === "out" && typeof e.lat !== "number");

function place(frame: Frame, lat: number, lng: number) {
	const c = project(frame.lat, frame.lng, frame.zoom);
	const p = project(lat, lng, frame.zoom);
	return { px: p.x - c.x + frame.w / 2, py: p.y - c.y + frame.h / 2 };
}

function fits(frame: Frame, px: number, py: number, inset = 26) {
	return px > inset && px < frame.w - inset && py > inset && py < frame.h - inset;
}

// The tightest frame that holds every pin, plus our own building.
let frame = frames[frames.length - 1];
for (const candidate of frames) {
	const home = place(candidate, CHURCH.lat, CHURCH.lng);
	if (!fits(candidate, home.px, home.py, 14)) continue;
	if (located.every((e) => {
		const p = place(candidate, e.lat!, e.lng!);
		return fits(candidate, p.px, p.py);
	})) {
		frame = candidate;
		break;
	}
}

const plotted: (Entry & { n: number; px: number; py: number; left: number; top: number })[] = [];
const offMap: Entry[] = [];
for (const e of located) {
	const p = place(frame, e.lat!, e.lng!);
	if (!fits(frame, p.px, p.py, 10)) {
		offMap.push(e);
		continue;
	}
	plotted.push({ ...e, n: plotted.length + 1, px: p.px, py: p.py, left: 0, top: 0 });
}

// Ministries sharing a building land on the same point, so nudge them apart
// just enough to be clickable, capped so a pin stays on its own street.
const MIN_GAP = 26;
const MAX_SHIFT = 15;
const origin = plotted.map((p) => ({ x: p.px, y: p.py }));
for (let pass = 0; pass < 40; pass++) {
	let moved = false;
	for (let i = 0; i < plotted.length; i++) {
		for (let j = i + 1; j < plotted.length; j++) {
			const a = plotted[i];
			const b = plotted[j];
			let dx = b.px - a.px;
			let dy = b.py - a.py;
			let d = Math.hypot(dx, dy);
			if (d >= MIN_GAP) continue;
			if (d < 0.01) {
				const angle = (i * 2.39996 + j) % (Math.PI * 2);
				dx = Math.cos(angle);
				dy = Math.sin(angle);
				d = 1;
			}
			const push = (MIN_GAP - d) / 2 / d;
			a.px -= dx * push;
			a.py -= dy * push;
			b.px += dx * push;
			b.py += dy * push;
			moved = true;
		}
	}
	if (!moved) break;
}
plotted.forEach((p, i) => {
	const dx = p.px - origin[i].x;
	const dy = p.py - origin[i].y;
	const d = Math.hypot(dx, dy);
	if (d > MAX_SHIFT) {
		p.px = origin[i].x + (dx / d) * MAX_SHIFT;
		p.py = origin[i].y + (dy / d) * MAX_SHIFT;
	}
	p.left = (p.px / frame.w) * 100;
	p.top = (p.py / frame.h) * 100;
});

const home = place(frame, CHURCH.lat, CHURCH.lng);
const homePos = { left: (home.px / frame.w) * 100, top: (home.py / frame.h) * 100 };
---

<div class="minmap">
	<div class="minmap__plot">
		<div class="minmap__frame" style={`aspect-ratio:${frame.w}/${frame.h}`}>
			<img
				src={frame.src}
				width={frame.w}
				height={frame.h}
				loading="lazy"
				decoding="async"
				alt={`Map of the Grand Rapids area showing ${label ?? "these ministries"}`}
			/>
			<div class="minmap__wash" aria-hidden="true"></div>

			<div class="minmap__here" style={`left:${homePos.left}%;top:${homePos.top}%`}>
				<span class="minmap__hereDot"></span>
				<span class="minmap__hereLabel">New Life</span>
			</div>

			{plotted.map((p) => (
				<a
					class="minmap__pin"
					href={`/ministry/${p.slug}`}
					style={`left:${p.left}%;top:${p.top}%`}
					aria-label={`${p.name}${p.venue ? `, at ${p.venue}` : ""}`}
				>
					<span class="minmap__num">{p.n}</span>
					<span class="minmap__tip" role="tooltip">
						<strong>{p.name}</strong>
						{p.venue && <span class="minmap__tipVenue">at {p.venue}</span>}
						{p.rhythm && <span class="minmap__tipWhen">{p.rhythm}</span>}
						{p.area && <span class="minmap__tipArea">{p.area}</span>}
					</span>
				</a>
			))}
		</div>
	</div>

	<div class="minmap__key">
		{plotted.length > 0 && (
			<>
				<p class="minmap__keyhead">On the map</p>
				<ol class="minmap__list">
					{plotted.map((p) => (
						<li>
							<span class="minmap__n">{p.n}</span>
							<a href={`/ministry/${p.slug}`}>{p.name}</a>
							<span class="minmap__d">{p.area}</span>
						</li>
					))}
				</ol>
			</>
		)}

		{offMap.length > 0 && (
			<div class="minmap__rest">
				<p class="minmap__keyhead">Further out</p>
				<ol class="minmap__list">
					{offMap.map((p) => (
						<li>
							<span class="minmap__n minmap__n--plain">·</span>
							<a href={`/ministry/${p.slug}`}>{p.name}</a>
							<span class="minmap__d">{p.city}</span>
						</li>
					))}
				</ol>
			</div>
		)}

		{unlocated.length > 0 && (
			<div class="minmap__rest">
				<p class="minmap__keyhead">Meets in many places</p>
				<ol class="minmap__list">
					{unlocated.map((p) => (
						<li>
							<span class="minmap__n minmap__n--plain">·</span>
							<a href={`/ministry/${p.slug}`}>{p.name}</a>
						</li>
					))}
				</ol>
			</div>
		)}
	</div>
</div>
