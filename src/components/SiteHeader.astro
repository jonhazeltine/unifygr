---
import { readNav } from "../lib/studio/nav";
import { service } from "../data/sunday";

interface Props {
	/** Where the wordmark points. */
	brandHref?: string;
}

const { brandHref = "/" } = Astro.props;

// The menus are content (content/nav.json), editable in the Page Builder.
const nav = await readNav();
---

<header class="chrome">
	<div class="chrome__bar">
		<a class="chrome__brand" href={brandHref}>New Life</a>

		<!-- The answer, on every page, without a tap. -->
		<a class="chrome__when" href="/sunday">
			<span class="chrome__when-time">{service.shortWhen}</span>
			<span class="chrome__when-place">{service.street}</span>
		</a>

		<button
			class="chrome__toggle"
			type="button"
			aria-label="Menu"
			aria-expanded="false"
			aria-controls="site-nav"
		>
			<span class="chrome__bars" aria-hidden="true"></span>
			<span class="chrome__toggle-label">Menu</span>
		</button>
	</div>

	<nav class="chrome__nav" id="site-nav" aria-label="Primary" hidden>
		<ul class="navlist">
			{nav.groups.map((g) => (
				<li class="navlist__item">
					<a class="navlist__link" href={g.href}>{g.label}</a>
					{g.items.length > 0 && (
						<ul class="navlist__sub">
							{g.items.map((it) => (
								<li><a href={it.href}>{it.label}</a></li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
		<a class="navlist__cta" href={nav.cta.href} target="_blank" rel="noopener">{nav.cta.label}</a>
	</nav>
</header>

<script>
	const chrome = document.querySelector(".chrome");
	const toggle = document.querySelector(".chrome__toggle");
	const nav = document.getElementById("site-nav");

	const setOpen = (open: boolean) => {
		chrome?.classList.toggle("is-open", open);
		toggle?.setAttribute("aria-expanded", open ? "true" : "false");
		if (nav) nav.hidden = !open;
	};

	setOpen(false);

	toggle?.addEventListener("click", () => {
		setOpen(!chrome?.classList.contains("is-open"));
	});

	nav?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => setOpen(false));
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") setOpen(false);
	});
</script>
