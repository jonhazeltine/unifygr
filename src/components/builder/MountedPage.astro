---
// Renders a builder page (content/pages/<slug>.json) — used both by /p/<slug>
// and by real routes that have been "blockified" (e.g. /staff). Drafts are
// staff-only with a banner; visitors get a 404.
//
// Tap pages (/tap, /next-steps) pass `bare`: one screen of big buttons, with
// no header, footer or menu wrapped around it.
import { Render } from "@measured/puck";
import Interior from "../../layouts/Interior.astro";
import Bare from "../../layouts/Bare.astro";
import { blocksConfig } from "./blocks";
import { readPage } from "../../lib/studio/pages";
import { isAuthed } from "../../lib/studio/auth";

interface Props {
	slug: string;
	bare?: boolean;
}

const { slug, bare = false } = Astro.props;
const data = await readPage(slug, Astro.locals);
const staff = isAuthed(Astro.cookies);

// A draft is invisible to anyone but staff. Returning a Response from a
// component only blanked the body — the route still answered 200, which is a
// blank page a search engine will happily index. Setting the status on the
// shared response makes it a real 404.
const hidden = !data || (data.status !== "live" && !staff);
if (hidden) {
	Astro.response.status = 404;
	Astro.response.headers.set("x-robots-tag", "noindex");
}
const isDraftPreview = !hidden && data!.status !== "live";
const title = hidden ? "New Life | Not found" : `New Life | ${data!.root.props.title || "Page"}`;
const description = hidden
	? "That page isn't here."
	: data!.root.props.description || data!.root.props.title || "New Life Grand Rapids";
const Layout = bare ? Bare : Interior;
---

<Layout title={title} description={description}>
	{hidden ? (
		<section class="section">
			<div class="container">
				<h1>Not found</h1>
				<p style="margin-top:.8rem"><a href="/">Back to New Life</a></p>
			</div>
		</section>
	) : (
	<>
	{isDraftPreview && (
		<div style="position:sticky;top:0;z-index:50;background:#f2d2a2;color:#12100c;text-align:center;font:600 13px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:9px 12px;letter-spacing:.02em;">
			DRAFT — only staff can see this page. Flip it live in the Page Builder.
		</div>
	)}
	<Render config={blocksConfig} data={data!} />
	</>
	)}
</Layout>

<script>
	import { parseEmbedHeightMessage, findEmbedFrame, clampEmbedHeight } from "../../lib/embed/panel-height";

	// Progressive enhancement for every PackSignupForm block on the page (see
	// blocks.tsx) — plain fetch + vanilla JS, the same pattern as /connect.astro,
	// since Puck's server-rendered blocks carry no client-side React.
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-pack-signup-form]")) {
		const wrap = form.closest(".pack-signup__wrap") ?? form.parentElement;
		const done = wrap?.querySelector<HTMLElement>("[data-pack-signup-done]");
		const error = form.querySelector<HTMLParagraphElement>("[data-pack-signup-error]");
		const submit = form.querySelector<HTMLButtonElement>("[data-pack-signup-submit]");
		const defaultLabel = submit?.textContent ?? "Save our table";

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!error || !submit || !done) return;

			error.hidden = true;
			submit.disabled = true;
			submit.textContent = "Sending…";

			const formData = new FormData(form);
			const payload = Object.fromEntries(formData.entries());

			try {
				const res = await fetch("/api/meals-of-hope/pack-signup", {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify(payload),
				});
				const data = await res.json().catch(() => ({}));
				if (!res.ok || !data.ok) throw new Error(data.error || "Something went wrong. Please try again.");
				form.hidden = true;
				done.hidden = false;
				done.scrollIntoView({ behavior: "smooth", block: "center" });
			} catch (err) {
				error.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
				error.hidden = false;
				submit.disabled = false;
				submit.textContent = defaultLabel;
			}
		});
	}

	// Progressive enhancement for a TapButtons link marked "open inline"
	// (see blocks.tsx) — plain vanilla JS, same pattern as above. With no JS
	// the element is a normal <a href> to the giving URL, so it still works.
	//
	// ONE scroll surface: a frame we control (our own ?embed=1 pages) posts
	// its real document height up via postMessage (see the "nlgr-embed-height"
	// listener below), and the panel grows to match with no scrollbar of its
	// own — the outer page is the only thing that scrolls. A frame we don't
	// control (SecureGive) never sends that message, so it keeps the fixed,
	// pre-tuned height in tap.css and scrolls internally at that size, chosen
	// so its form fits a 375×812 phone without needing to.
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	function scrollPanelIntoView(panel: HTMLElement) {
		const rect = panel.getBoundingClientRect();
		const top = window.scrollY + rect.top - 12; // just under the button
		window.scrollTo({ top: Math.max(top, 0), behavior: reduceMotion ? "auto" : "smooth" });
	}

	let triggerIdCounter = 0;

	for (const trigger of document.querySelectorAll<HTMLAnchorElement>("[data-tapbtn-embed]")) {
		trigger.addEventListener("click", (event) => {
			const targetId = trigger.getAttribute("data-tapbtn-embed-target");
			const panel = targetId ? document.getElementById(targetId) : null;
			if (!panel) return;
			event.preventDefault();

			const frame = panel.querySelector<HTMLElement>("[data-tapbtn-embed-frame]");
			if (frame && !frame.querySelector("iframe")) {
				const src = frame.getAttribute("data-src");
				if (src) {
					const iframe = document.createElement("iframe");
					iframe.src = src;
					iframe.title = trigger.textContent?.trim() || "Give online";
					iframe.style.cssText = "width:100%;height:100%;border:0;display:block;";
					// Let touch scrolling hand off to the page smoothly at the
					// frame's edges instead of trapping it (matters for the
					// fixed-height SecureGive frame, which scrolls internally).
					iframe.setAttribute("style", iframe.getAttribute("style") + "overscroll-behavior:auto;");
					frame.appendChild(iframe);
				}
			}

			if (!trigger.id) trigger.id = `tapbtn-embed-trigger-${++triggerIdCounter}`;
			panel.dataset.tapbtnEmbedTrigger = trigger.id;

			panel.hidden = !panel.hidden;
			if (!panel.hidden) requestAnimationFrame(() => scrollPanelIntoView(panel));
		});
	}

	for (const closeBtn of document.querySelectorAll<HTMLButtonElement>("[data-tapbtn-embed-close]")) {
		closeBtn.addEventListener("click", () => {
			const panel = closeBtn.closest<HTMLElement>("[data-tapbtn-embed-panel]");
			if (!panel) return;
			panel.hidden = true;
			const triggerId = panel.dataset.tapbtnEmbedTrigger;
			const trigger = triggerId ? document.getElementById(triggerId) : null;
			trigger?.focus();
		});
	}

	// Accepts a height only from a window we ourselves put in an iframe —
	// checked by object identity against event.source (findEmbedFrame), never
	// by string-matching event.origin, so it works the same for our own
	// ?embed=1 pages and (once the Church Map lead wires it up on their side)
	// any thechurchmap.com frame, with no allowlist to maintain. A message
	// from anything else (e.g. an ad inside SecureGive) matches no iframe here
	// and is ignored. See src/lib/embed/panel-height.ts for the unit-tested
	// parsing/matching/clamping logic.
	window.addEventListener("message", (event) => {
		const height = parseEmbedHeightMessage(event.data);
		if (height == null) return;

		const frames = Array.from(document.querySelectorAll<HTMLIFrameElement>("[data-tapbtn-embed-frame] iframe"));
		const iframe = findEmbedFrame(frames, event.source);
		if (!iframe) return;
		const panel = iframe.closest<HTMLElement>("[data-tapbtn-embed-panel]");
		if (!panel) return;

		panel.style.setProperty("--tapbtn-embed-panel-height", `${clampEmbedHeight(height)}px`);
		panel.classList.add("tapbtn-embed-panel--auto");
	});
</script>
