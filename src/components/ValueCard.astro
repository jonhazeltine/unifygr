---
interface Props {
  title: string;
  body: string;
  index: number;
  visible?: boolean;
}
const { title, body, index, visible = false } = Astro.props;
// Individual source photographs preserve each painting's full composition.
// The old contact sheet required enlarging small clipped regions, which made
// several cards soft and unnecessarily cropped.
const paintings: Record<string, string> = {
  "Passion for Jesus": "/art/values/passion-for-jesus-original.jpg",
  "Transparent Relationships": "/art/values/transparent-relationships-original.jpg",
  "Supernatural Life": "/art/values/supernatural-life-original.jpg",
  "Godly Character": "/art/values/godly-character-original.jpg",
  "Passion for People": "/art/values/passion-for-people-original.jpg",
};
---
<article class:list={["value-card", "painted-value", "reveal", { "is-visible": visible }]} style={`--delay:${index * 60}ms`}>
  <img class="painted-value__photo" src={paintings[title]} width="480" height="640" alt="" loading="lazy" />
  <div class="painted-value__copy">
    <h3>{title}</h3>
    <p>{body}</p>
  </div>
</article>
<style>
  .painted-value {
    isolation: isolate;
    overflow: hidden;
    min-height: 480px;
    display: grid;
    grid-template-rows: 270px 1fr;
    padding: 0;
    background: #101722;
    border-color: rgba(222, 187, 128, .24);
  }
  .painted-value__photo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    z-index: -2;
  }
  .painted-value__copy {
    position: relative;
    grid-row: 2;
    min-height: 210px;
    width: 100%;
    box-sizing: border-box;
    padding: 1rem;
    text-shadow: 0 1px 4px #080f1a, 0 0 12px rgba(8,15,26,.8);
    background: linear-gradient(to bottom, rgba(8,15,26,.15), rgba(8,15,26,.68) 38%, rgba(8,15,26,.88));
  }
  .painted-value__copy::before {
    content: "";
    position: absolute;
    inset: -90px 0 auto;
    height: 90px;
    background: linear-gradient(to bottom, transparent, rgba(8,15,26,.15));
    pointer-events: none;
  }
  .painted-value h3 {
    margin: 0 0 .7rem;
    color: #fff5e4;
    font-size: clamp(1.2rem, 2vw, 1.35rem);
    line-height: 1.15;
  }
  .painted-value p {
    margin: 0;
    color: #eee6d9;
    font-size: .95rem;
    line-height: 1.45;
  }
  @media (max-width: 520px) {
    .painted-value { min-height: 490px; grid-template-rows: 280px 1fr; }
  }
</style>
