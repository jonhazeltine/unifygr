---
interface Props {
  title: string;
  body: string;
  index: number;
  visible?: boolean;
}
const { title, body, index, visible = false } = Astro.props;
// Original 2024 church artwork sheet. Viewports exclude the printed labels;
// the source paintings remain unmodified. Source: Asana asset 1206967082301274.
const paintings: Record<string, string> = {
  "Passion for Jesus": "358 67 332 484",
  "Transparent Relationships": "100 729 240 200",
  "Supernatural Life": "358 607 332 310",
  "Godly Character": "100 67 239 282",
  "Passion for People": "100 391 240 297",
};
const [x, y, width, height] = paintings[title].split(" ").map(Number);
const clipId = `value-painting-${index}`;
---
<article class:list={["value-card", "painted-value", "reveal", { "is-visible": visible }]} style={`--delay:${index * 60}ms`}>
  {title === "Passion for Jesus" ? (
    <img class="painted-value__photo" src="/art/values/passion-for-jesus-original.jpg" width="482" height="640" alt="" loading="lazy" />
  ) : (
  <svg class="painted-value__art" viewBox={paintings[title]} preserveAspectRatio="xMidYMin meet" aria-hidden="true" focusable="false">
    <defs><clipPath id={clipId}><rect {x} {y} {width} {height} /></clipPath></defs>
    <image href="/art/values/core-values-paintings-2024.webp" width="715" height="1017" clip-path={`url(#${clipId})`} />
  </svg>
  )}
  <div class="painted-value__copy">
    <h3>{title}</h3>
    <p>{body}</p>
  </div>
</article>
<style>
  .painted-value {
    isolation: isolate;
    overflow: hidden;
    min-height: 390px;
    display: flex;
    align-items: flex-end;
    padding: 0;
    background: #101722;
    border-color: rgba(222, 187, 128, .24);
  }
  .painted-value__photo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    z-index: -2;
  }
  .painted-value__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  .painted-value__copy {
    width: 100%;
    box-sizing: border-box;
    padding: 1.35rem;
    background: #080f1a;
  }
  .painted-value h3 {
    margin: 0 0 .7rem;
    color: #fff5e4;
    font-size: clamp(1.4rem, 2.4vw, 1.7rem);
    line-height: 1.15;
  }
  .painted-value p {
    margin: 0;
    color: #eee6d9;
    font-size: 1rem;
    line-height: 1.6;
  }
  @media (max-width: 520px) {
    .painted-value { min-height: 410px; }
  }
</style>
