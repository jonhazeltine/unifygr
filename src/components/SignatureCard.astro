---
// A signature ministry — one of the few things New Life runs itself.
//
// These carry more weight than a directory card, so they get more room: an
// image, a name, and one line on the front, and everything else behind a click.
// What we actually do and why we do it that way is worth reading, but not worth
// making somebody scroll past five times to reach the ministry they came for.
import type { Entry } from "../data/ministries";

interface Props {
	entry: Entry;
	/** Background image for the card, when it has an approved people-first treatment. */
	image?: string;
	/** Where "more about" goes — resolved by the page, since a draft page 404s. */
	href?: string;
	/** Ministry directories use a light, uncropped people-first treatment. */
	light?: boolean;
	/** Reserves the approved image's native aspect ratio before it lazy-loads. */
	imageSize?: { width: number; height: number };
}

const { entry, image, href, light = false, imageSize } = Astro.props;
const id = `sig-${entry.slug}`;
const toggleId = `${id}-toggle`;
// Ours meet in our building; what travels says where it goes.
const where = entry.house === "in" && entry.venue ? entry.venue : (entry.city ?? entry.venue ?? null);
---

<article class="sig">
	<button class:list={["sig__face", { "sig__face--light": light }]} type="button" id={toggleId} aria-expanded="false" aria-controls={id}>
		{light && image ? (
			<img class="sig__image" src={image} width={imageSize?.width} height={imageSize?.height} alt="" aria-hidden="true" loading={light ? "eager" : "lazy"} decoding="async" />
		) : light ? (
			<span class="sig__placeholder" aria-hidden="true"></span>
		) : (
			<>
				<span class="sig__art" style={`background-image:url(${image})`} aria-hidden="true"></span>
				<span class="sig__scrim" aria-hidden="true"></span>
			</>
		)}
		<span class="sig__head">
			{entry.rhythm && <span class="sig__when">{entry.rhythm}</span>}
			<span class="sig__name">{entry.name}</span>
			<span class="sig__line">{entry.summary}</span>
		</span>
		<span class="sig__more" aria-hidden="true">
			<span class="sig__more-open">What this is</span>
			<span class="sig__more-shut">Close</span>
		</span>
	</button>

	<div class="sig__body-anchor">
		<div class="sig__body" id={id} role="region" aria-labelledby={toggleId} hidden>
			<div class="sig__detail-heading">
				<h3>{entry.name}</h3>
				<button class="sig__close" type="button" aria-label={`Close details for ${entry.name}`}>Close</button>
			</div>
		{entry.why && (
			<div class="sig__why">
				<p class="eyebrow">Why we do it this way</p>
				<p>{entry.why}</p>
			</div>
		)}
		<dl class="sig__facts">
			{entry.bestFor && (<><dt>Who it's for</dt><dd>{entry.bestFor}</dd></>)}
			{where && (<><dt>Where</dt><dd>{where}</dd></>)}
			{entry.handoff?.how && (<><dt>Taking a step</dt><dd>{entry.handoff.how}</dd></>)}
		</dl>
		<p class="sig__go">
			<a href={href ?? entry.href ?? `/ministry/${entry.slug}`}>More about {entry.name}</a>
		</p>
		</div>
	</div>
</article>

<style>
	.sig { border-radius: 18px; overflow: hidden; background: var(--panel); border: 1px solid var(--line); }
	.sig:has(.sig__face[aria-expanded="true"]) { border-color: var(--gold-soft, var(--line)); }

	.sig__face {
		position: relative; display: block; width: 100%; text-align: left;
		border: 0; padding: 0; color: inherit; font: inherit; cursor: pointer; background: none;
		min-height: clamp(13rem, 24vw, 17rem);
	}
	.sig__art {
		position: absolute; inset: 0; background-size: cover; background-position: center;
		transform: scale(1.02); transition: transform 0.6s ease;
	}
	.sig__face:hover .sig__art { transform: scale(1.06); }
	.sig__scrim {
		position: absolute; inset: 0;
		background: linear-gradient(180deg, rgba(8,10,16,0.08) 0%, rgba(8,10,16,0.52) 62%, rgba(8,10,16,0.76) 100%);
	}
	.sig__head { position: relative; display: block; padding: clamp(1.2rem, 3vw, 1.9rem); padding-top: clamp(6rem, 14vw, 9rem); }
	.sig__when { display: block; font-size: 0.76rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-soft, #d8bd82); margin-bottom: 0.45rem; }
	.sig__name {
		display: block; font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
		font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.05; letter-spacing: -0.02em; color: #f6f0e7;
	}
	.sig__line { display: block; margin-top: 0.55rem; max-width: 44ch; color: rgba(246,240,231,0.82); font-size: 0.95rem; line-height: 1.55; }
	.sig__more {
		position: absolute; right: clamp(1.2rem, 3vw, 1.9rem); top: clamp(1.2rem, 3vw, 1.9rem);
		font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
		color: #f6f0e7; background: rgba(8,10,16,0.5); border: 1px solid rgba(246,240,231,0.35);
		border-radius: 999px; padding: 0.42rem 0.85rem; backdrop-filter: blur(6px);
	}

	/* On ministry pages, people are the art. Preserve the approved photograph's
	   native framing instead of turning it into a dark text backdrop. */
	.sig__face--light { background: #fffdf9; color: #17202b; }
	.sig__image, .sig__placeholder {
		display: block; width: 100%; aspect-ratio: 16 / 9; height: auto;
		object-fit: cover; background: #ece4d6;
	}
	.sig__placeholder { background: linear-gradient(145deg, #f0e9de, #e5dac9); }
	.sig__image[src$="prayer-pray.webp"] { object-position: center 55%; }
	.sig__face--light .sig__head { padding-top: clamp(1.2rem, 3vw, 1.9rem); }
	.sig__face--light .sig__when { color: #765a2b; }
	.sig__face--light .sig__name { color: #17202b; }
	.sig__face--light .sig__line { color: rgba(23,32,43,.72); }
	.sig__face--light .sig__more {
		position: relative; top: auto; right: auto; display: inline-flex; width: fit-content;
		margin: 0 1.2rem 1.2rem; color: #17202b; background: rgba(255,253,249,.94);
		border-color: rgba(23,32,43,.2);
	}

	.sig__more-shut { display: none; }
	.sig__face[aria-expanded="true"] .sig__more-open { display: none; }
	.sig__face[aria-expanded="true"] .sig__more-shut { display: inline; }

	/* display:grid would otherwise win over the hidden attribute and open every
	   card on load. */
	.sig__body[hidden] { display: none; }
	.sig__body { padding: clamp(1.2rem, 3vw, 1.9rem); display: grid; gap: 1.4rem; }
	:global(.sig-detail-panel) {
		flex: 0 0 100%; padding: 0; scroll-margin-block: 5rem;
		border: 1px solid var(--gold-soft, var(--line)); border-radius: 18px;
		background: var(--panel); overflow: hidden;
	}
	.sig__detail-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.sig__detail-heading h3 { margin: 0; max-width: none; font-family: "Iowan Old Style", Georgia, serif; font-size: clamp(1.3rem, 2.5vw, 1.7rem); letter-spacing: -0.03em; }
	.sig__close { flex: none; border: 1px solid var(--line); border-radius: 999px; padding: 0.38rem 0.75rem; color: var(--muted); background: transparent; font: inherit; font-size: 0.78rem; cursor: pointer; }
	.sig__close:hover, .sig__close:focus-visible { color: var(--text); border-color: var(--gold-soft, var(--line)); }
	.sig__why p:last-child { margin: 0.4rem 0 0; color: var(--text); line-height: 1.75; max-width: 70ch; }
	.sig__facts { display: grid; grid-template-columns: 1fr; gap: 0.25rem; margin: 0; }
	.sig__facts dt { margin-top: 0.85rem; color: var(--muted); font-size: 0.82rem; }
	.sig__facts dt:first-child { margin-top: 0; }
	.sig__facts dd { margin: 0; max-width: 70ch; line-height: 1.6; }
	.sig__go { margin: 0; }
	.sig__go a { color: var(--gold-soft, #d8bd82); }
	.sig:has(.sig__face--light) .sig__go a { color: #765a2b; }

</style>

<script>
	function bodyFor(face: HTMLButtonElement) {
		return document.getElementById(face.getAttribute("aria-controls")!) as HTMLDivElement | null;
	}

	function panelFor(grid: HTMLElement) {
		let panel = grid.querySelector<HTMLDivElement>(":scope > .sig-detail-panel");
		if (!panel) {
			panel = document.createElement("div");
			panel.className = "sig-detail-panel";
			panel.hidden = true;
			grid.append(panel);
		}
		return panel;
	}

	function returnBody(body: HTMLDivElement) {
		const card = document.querySelector<HTMLButtonElement>(`.sig__face[aria-controls="${body.id}"]`)?.closest(".sig");
		const anchor = card?.querySelector(".sig__body-anchor");
		if (anchor) anchor.append(body);
		body.hidden = true;
	}

	function placePanel(grid: HTMLElement, face: HTMLButtonElement, panel: HTMLDivElement) {
		panel.hidden = true;
		const cards = [...grid.querySelectorAll<HTMLElement>(":scope > .sig")];
		const selected = face.closest<HTMLElement>(".sig");
		if (!selected) return;
		const rowTop = selected.offsetTop;
		const row = cards.filter((card) => Math.abs(card.offsetTop - rowTop) < 2);
		(row.at(-1) ?? selected).after(panel);
		panel.hidden = false;
	}

	function closeDetails(face: HTMLButtonElement, body: HTMLDivElement, panel: HTMLDivElement, returnFocus = false) {
		face.setAttribute("aria-expanded", "false");
		returnBody(body);
		panel.hidden = true;
		if (returnFocus) face.focus();
	}

	function closeGrid(grid: HTMLElement, except?: HTMLButtonElement) {
		grid.querySelectorAll<HTMLButtonElement>(".sig__face[aria-expanded=\"true\"]").forEach((openFace) => {
			if (openFace === except) return;
			const body = bodyFor(openFace);
			const panel = grid.querySelector<HTMLDivElement>(":scope > .sig-detail-panel");
			if (body && panel) closeDetails(openFace, body, panel);
		});
	}

	// The row can change when the viewport crosses a responsive breakpoint.
	let resizeFrame = 0;
	window.addEventListener("resize", () => {
		cancelAnimationFrame(resizeFrame);
		resizeFrame = requestAnimationFrame(() => {
			document.querySelectorAll<HTMLElement>(".sig-grid").forEach((grid) => {
				const face = grid.querySelector<HTMLButtonElement>(".sig__face[aria-expanded=\"true\"]");
				const panel = grid.querySelector<HTMLDivElement>(":scope > .sig-detail-panel");
				if (face && panel) placePanel(grid, face, panel);
			});
		});
	});

	document.querySelectorAll<HTMLButtonElement>(".sig__face").forEach((face) => {
		face.addEventListener("click", () => {
			const grid = face.closest<HTMLElement>(".sig-grid");
			const body = bodyFor(face);
			if (!grid || !body) return;
			const isOpen = face.getAttribute("aria-expanded") === "true";
			const panel = panelFor(grid);
			if (isOpen) {
				closeDetails(face, body, panel);
				return;
			}
			closeGrid(grid, face);
			body.hidden = false;
			panel.append(body);
			face.setAttribute("aria-expanded", "true");
			placePanel(grid, face, panel);
			requestAnimationFrame(() => panel.scrollIntoView({ block: "nearest", behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }));
		});
	});

	document.querySelectorAll<HTMLButtonElement>(".sig__close").forEach((close) => {
		close.addEventListener("click", () => {
			const body = close.closest<HTMLDivElement>(".sig__body");
			const face = body ? document.getElementById(body.getAttribute("aria-labelledby")!) as HTMLButtonElement | null : null;
			const panel = close.closest<HTMLDivElement>(".sig-detail-panel");
			if (body && face && panel) closeDetails(face, body, panel, true);
		});
	});

	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") return;
		const panel = (event.target as Element).closest<HTMLDivElement>(".sig-detail-panel");
		const body = panel?.querySelector<HTMLDivElement>(".sig__body");
		const face = body ? document.getElementById(body.getAttribute("aria-labelledby")!) as HTMLButtonElement | null : null;
		if (panel && body && face) closeDetails(face, body, panel, true);
	});
</script>
