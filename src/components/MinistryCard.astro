---
// The ministry is the headline. The church it meets in is the address.
import { isOffering, type Entry } from "../data/ministries";

interface Props {
	entry: Entry;
	/** Show the longer note. Off in dense lists. */
	full?: boolean;
	/** Other categories on this page the ministry also belongs to. */
	alsoIn?: { name: string; href: string }[];
}

const { entry, full = false, alsoIn = [] } = Astro.props;
const inHouse = entry.house === "in";
const venue = entry.venue ?? (inHouse ? "New Life, Knapp's Corner" : entry.org);
const onCalendar = isOffering(entry) && entry.house === "out";
const area = entry.city ?? entry.area ?? "";
---

<article
	class={`min-card ${inHouse ? "min-card--in" : "min-card--out"}`}
	data-house={entry.house}
	data-area={area}
	data-live={onCalendar ? "1" : "0"}
>
	<div class="min-card__top">
		{area && <span class="min-card__area">{area}</span>}
		{/* Signature or curated belongs on the card, not in a banner above every block. */}
		{inHouse && <span class="min-card__ours">Signature</span>}
		{onCalendar && <span class="min-card__live">Curated</span>}
	</div>

	<h3 class="min-card__name">
		<a href={`/ministry/${entry.slug}`}>{entry.name}</a>
	</h3>

	{venue && <p class="min-card__venue">at {venue}</p>}
	{entry.rhythm && <p class="min-card__when">{entry.rhythm}</p>}

	<p class="min-card__summary">{entry.summary}</p>

	{full && entry.why && <p class="min-card__note">{entry.why}</p>}

	{alsoIn.length > 0 && (
		<p class="min-card__also">
			Also in{" "}
			{alsoIn.map((c, i) => (
				<>
					{i > 0 && ", "}
					<a href={c.href}>{c.name}</a>
				</>
			))}
		</p>
	)}
</article>
