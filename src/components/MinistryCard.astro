---
// The ministry is the headline. The church it meets in is the address.
import { STATUS_LABEL, isOffering, type Entry } from "../data/ministries";

interface Props {
	entry: Entry;
	/** Show the longer note. Off in dense lists. */
	full?: boolean;
}

const { entry, full = false } = Astro.props;
const inHouse = entry.house === "in";
const unverified = entry.status !== "live";
const venue = entry.venue ?? (inHouse ? "New Life, Knapp's Corner" : entry.org);
---

<article class={`min-card ${inHouse ? "min-card--in" : "min-card--out"}`}>
	<div class="min-card__top">
		{(entry.city ?? entry.area) && <span class="min-card__area">{entry.city ?? entry.area}</span>}
		{isOffering(entry) && entry.house === "out" && <span class="min-card__live">On our calendar</span>}
	</div>

	<h3 class="min-card__name">
		<a href={`/ministry/${entry.slug}`}>{entry.name}</a>
	</h3>

	{venue && <p class="min-card__venue">at {venue}</p>}
	{entry.rhythm && <p class="min-card__when">{entry.rhythm}</p>}

	<p class="min-card__summary">{entry.summary}</p>

	{full && entry.why && <p class="min-card__note">{entry.why}</p>}

	{unverified && (
		<p class="min-card__flag">{STATUS_LABEL[entry.status] ?? entry.status}</p>
	)}
</article>
