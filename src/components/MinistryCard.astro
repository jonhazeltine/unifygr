---
import { TIER_LABEL, STATUS_LABEL, type Entry } from "../data/ministries";

interface Props {
	entry: Entry;
	/** Show the "why we point here" paragraph. Off in dense lists. */
	full?: boolean;
}

const { entry, full = false } = Astro.props;
const inHouse = entry.house === "in";
const tierLabel = TIER_LABEL[entry.tier] ?? entry.tier;
const unverified = entry.status !== "live";
---

<article class={`min-card ${inHouse ? "min-card--in" : "min-card--out"}`}>
	<div class="min-card__top">
		<span class={`min-tag ${inHouse ? "min-tag--in" : "min-tag--out"}`}>{tierLabel}</span>
		{entry.area && <span class="min-card__area">{entry.area}</span>}
	</div>

	<h3 class="min-card__name">
		<a href={`/ministry/${entry.slug}`}>{entry.name}</a>
	</h3>
	{entry.org && entry.org !== entry.name && <p class="min-card__org">{entry.org}</p>}

	<p class="min-card__summary">{entry.summary}</p>

	{full && entry.why && (
		<p class="min-card__why"><span>Why we point here.</span> {entry.why}</p>
	)}

	<div class="min-card__meta">
		{entry.rhythm && <span>{entry.rhythm}</span>}
		{entry.city && entry.city !== "Grand Rapids" && <span>{entry.city}</span>}
	</div>

	{unverified && (
		<p class="min-card__flag">{STATUS_LABEL[entry.status] ?? entry.status}</p>
	)}
</article>
