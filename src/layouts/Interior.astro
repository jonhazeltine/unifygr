---
// The layout the older content pages still use. It now wears the same chrome
// and footer as the new pages, so the service time is in the header wherever a
// visitor lands.
//
// Embed mode: any page using this layout can be requested with `?embed=1`
// (e.g. for a TapButtons inline panel — see blocks.tsx / MountedPage.astro).
// That renders the SAME page content with no header, nav, footer or Studio
// dock, and a transparent background sized to sit inside a dark panel at
// about 330px wide. Without `?embed=1` a page is completely unchanged. This
// lives here (rather than a per-page *Embed.astro copy like ConnectEmbed) so
// any page on Interior gets embed support for free.
import BaseHead from "../components/BaseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { isPagePublished } from "../lib/studio/page-visibility";
import { pageOgImage } from "../lib/studio/pages";
import StudioDock from "../components/StudioDock.astro";
import { runtimeSite } from "../data/site";
import { serviceForChurch } from "../data/sunday";
import "../styles/sunday.css";
import "../styles/tap.css";

interface Props {
	title: string;
	description: string;
	image?: string;
	kicker?: string;
	heading?: string;
	lede?: string;
}

const { title, description, image, kicker, heading, lede } = Astro.props;
const year = new Date().getFullYear();
const isEmbed = Astro.url.searchParams.get("embed") === "1";
const footerLinks = isEmbed ? [] : (await Promise.all([
	["/sunday", "Plan your visit"], ["/watch", "Watch a service"], ["/beliefs", "What we believe"], ["/ministries", "Ministries"], ["/giving", "Give"],
].map(async ([href, label]) => ({ href, label, published: await isPagePublished(href, Astro.locals) })))).filter((link) => link.published);
const { church } = await runtimeSite(Astro.locals);
const service = serviceForChurch(church);
const isMinistry = Astro.url.pathname === "/ministries"
	|| Astro.url.pathname.startsWith("/ministries/")
	|| Astro.url.pathname.startsWith("/ministry/");
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image ?? pageOgImage(Astro.url.pathname)} />
		<link rel="preload" href="/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin />
		{isEmbed && (
			<style>
				/* Readable down to about 330px wide, and transparent so the
				   frame matches whatever dark panel it sits inside instead of
				   showing its own backdrop. overflow: hidden means this
				   document never grows its own scrollbar — the parent page
				   (MountedPage.astro) resizes the iframe to fit, so the outer
				   page stays the only scroll surface. */
				html, body { background: transparent; overflow: hidden; }
				body::before, body::after { display: none; }
				.pagehead { padding-top: 0.4rem; }
				.landing-shell { padding-top: 0; }
				.section { padding: 1.1rem 0.4rem; }
				.container { padding: 0; }
			</style>
		)}
		{isEmbed && (
			<script>
				// Tells the parent page how tall this embedded document
				// actually is, so it can size the iframe with no scrollbar of
				// its own — the outer page stays the only scroll surface (see
				// the "nlgr-embed-height" listener in MountedPage.astro).
				(function postEmbedHeight() {
					let lastHeight = 0;
					function post() {
						const height = Math.ceil(document.documentElement.getBoundingClientRect().height);
						if (!height || Math.abs(height - lastHeight) < 2) return;
						lastHeight = height;
						window.parent.postMessage({ type: "nlgr-embed-height", height }, "*");
					}
					if (typeof ResizeObserver !== "undefined") {
						new ResizeObserver(() => post()).observe(document.documentElement);
					}
					window.addEventListener("load", post);
					document.addEventListener("nlgr:embed-height-refresh", post);
					if (document.fonts?.ready) document.fonts.ready.then(post).catch(() => {});
					post();
					setTimeout(post, 300);
				})();
			</script>
		)}
	</head>
	<body class:list={["v2", { "v2--ministry": isMinistry, "v2--embed": isEmbed }]}>
		{!isEmbed && <SiteHeader church={church} />}

		<main class="landing-shell">
			{(kicker || heading || lede) && (
				<section class="pagehead">
					<div class="shell">
						{kicker && <p class="band__label">{kicker}</p>}
						{heading && <h1>{heading}</h1>}
						{lede && <p>{lede}</p>}
					</div>
				</section>
			)}

			<slot />
		</main>

		{!isEmbed && (
			<footer class="foot">
				<div class="shell foot__grid">
					<div>
						<p class="foot__brand">{church.name}</p>
						<p>{service.street}<br />{service.city}, {service.state} {service.zip}</p>
						<p style="margin-top:.6rem">{service.shortWhen}</p>
					</div>
					<nav aria-label="Footer">
						{footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
					</nav>
					<div>
						<a href={church.mapUrl} target="_blank" rel="noopener">Directions</a>
						<a href={church.social.facebook} target="_blank" rel="noopener">Facebook</a>
						<a href={church.social.instagram} target="_blank" rel="noopener">Instagram</a>
						<a href={church.social.youtube} target="_blank" rel="noopener">YouTube</a>
					</div>
				</div>
				<div class="shell" style="margin-top:2.4rem">
					<p>© {year} {church.name}</p>
				</div>
			</footer>
		)}

		{!isEmbed && <StudioDock />}
	</body>
</html>
