---
// The layout the older content pages still use. It now wears the same chrome
// and footer as the new pages, so the service time is in the header wherever a
// visitor lands.
import BaseHead from "../components/BaseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StudioDock from "../components/StudioDock.astro";
import { church } from "../data/site";
import { service } from "../data/sunday";
import "../styles/sunday.css";
import "../styles/tap.css";

interface Props {
	title: string;
	description: string;
	kicker?: string;
	heading?: string;
	lede?: string;
}

const { title, description, kicker, heading, lede } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<link rel="preload" href="/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body class="v2">
		<SiteHeader />

		<main class="landing-shell">
			{(kicker || heading || lede) && (
				<section class="pagehead">
					<div class="shell">
						{kicker && <p class="band__label">{kicker}</p>}
						{heading && <h1>{heading}</h1>}
						{lede && <p>{lede}</p>}
					</div>
				</section>
			)}

			<slot />
		</main>

		<footer class="foot">
			<div class="shell foot__grid">
				<div>
					<p class="foot__brand">{church.name}</p>
					<p>{service.street}<br />{service.city}, {service.state} {service.zip}</p>
					<p style="margin-top:.6rem">{service.shortWhen}</p>
				</div>
				<nav aria-label="Footer">
					<a href="/sunday">Plan your visit</a>
					<a href="/watch">Watch a service</a>
					<a href="/beliefs">What we believe</a>
					<a href="/ministries">Ministries</a>
					<a href="/giving">Give</a>
				</nav>
				<div>
					<a href={`tel:${church.phone.replace(/\./g, "")}`}>{church.phone}</a>
					<a href={`mailto:${church.email}`}>{church.email}</a>
					<a href={church.mapUrl} target="_blank" rel="noopener">Directions</a>
					<a href={church.social.facebook} target="_blank" rel="noopener">Facebook</a>
					<a href={church.social.instagram} target="_blank" rel="noopener">Instagram</a>
					<a href={church.social.youtube} target="_blank" rel="noopener">YouTube</a>
				</div>
			</div>
			<div class="shell" style="margin-top:2.4rem">
				<p>© {year} {church.name}</p>
			</div>
		</footer>

		<StudioDock />
	</body>
</html>
