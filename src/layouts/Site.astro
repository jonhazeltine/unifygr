---
import BaseHead from "../components/BaseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { isPagePublished } from "../lib/studio/page-visibility";
import { pageOgImage } from "../lib/studio/pages";
import StudioDock from "../components/StudioDock.astro";
import { runtimeSite } from "../data/site";
import { serviceForChurch } from "../data/sunday";
import "../styles/sunday.css";

interface Props {
	title: string;
	description: string;
	image?: string;
	brandHref?: string;
}

const { title, description, image, brandHref = "/" } = Astro.props;
const year = new Date().getFullYear();
const footerLinks = (await Promise.all([
	["/sunday", "Plan your visit"], ["/watch", "Watch a service"], ["/beliefs", "What we believe"], ["/ministries", "Ministries"], ["/giving", "Give"],
].map(async ([href, label]) => ({ href, label, published: await isPagePublished(href, Astro.locals) })))).filter((link) => link.published);
const { church } = await runtimeSite(Astro.locals);
const service = serviceForChurch(church);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image ?? pageOgImage(Astro.url.pathname)} />
		<link rel="preload" href="/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body class="v2">
		<SiteHeader brandHref={brandHref} church={church} />

		<main>
			<slot />
		</main>

		<footer class="foot">
			<div class="shell foot__grid">
				<div>
					<p class="foot__brand">{church.name}</p>
					<p>{service.street}<br />{service.city}, {service.state} {service.zip}</p>
					<p style="margin-top:.6rem">{service.shortWhen}</p>
				</div>
				<nav aria-label="Footer">
					{footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
				</nav>
				<div>
					<a href={church.mapUrl} target="_blank" rel="noopener">Directions</a>
					<a href={church.social.facebook} target="_blank" rel="noopener">Facebook</a>
					<a href={church.social.instagram} target="_blank" rel="noopener">Instagram</a>
					<a href={church.social.youtube} target="_blank" rel="noopener">YouTube</a>
				</div>
			</div>
			<div class="shell" style="margin-top:2.4rem">
				<p>© {year} {church.name}</p>
			</div>
		</footer>

		<StudioDock />
	</body>
</html>
