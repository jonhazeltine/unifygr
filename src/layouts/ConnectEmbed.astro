---
// The bare document used for /connect?embed=1 — the same Connect Card form,
// meant to live inside an <iframe> on a tap/next-steps button (see
// TapButtons in blocks.tsx). No site header, nav, footer or Studio dock, and
// nothing in here can navigate the frame away. Kept as its own layout file
// (rather than an inline conditional in connect.astro) so it gets a real
// leading doctype the same way every other page does.
import BaseHead from "../components/BaseHead.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* Readable down to about 330px wide, and transparent so the frame
			   matches whatever panel it sits inside instead of showing its own
			   backdrop. overflow: hidden means this document never grows its
			   own scrollbar — the parent page (MountedPage.astro) resizes the
			   iframe to fit, so the page is the only scroll surface. */
			html, body { background: transparent; overflow: hidden; }
			body::before, body::after { display: none; }
			.section { padding: 1.1rem 0.4rem; }
			.container { padding: 0; }
			.connect-wrap { max-width: 100%; }
		</style>
	</head>
	<body class="v2 connect-embed">
		<section class="section">
			<slot />
		</section>
	</body>
</html>

<script>
	// Tells the parent page how tall this embedded document actually is, so
	// it can size the iframe with no scrollbar of its own — the outer page
	// stays the only scroll surface (see the "nlgr-embed-height" listener in
	// MountedPage.astro). Fires on load, once fonts settle, on any DOM size
	// change, and whenever the Connect form dispatches
	// "nlgr:embed-height-refresh" ("Add something else" and the post-submit
	// thank-you screen each change height without always tripping a resize).
	(function postEmbedHeight() {
		let lastHeight = 0;
		function post() {
			const height = Math.ceil(document.documentElement.getBoundingClientRect().height);
			if (!height || Math.abs(height - lastHeight) < 2) return;
			lastHeight = height;
			window.parent.postMessage({ type: "nlgr-embed-height", height }, "*");
		}
		if (typeof ResizeObserver !== "undefined") {
			new ResizeObserver(() => post()).observe(document.documentElement);
		}
		window.addEventListener("load", post);
		document.addEventListener("nlgr:embed-height-refresh", post);
		if (document.fonts?.ready) document.fonts.ready.then(post).catch(() => {});
		post();
		setTimeout(post, 300);
	})();
</script>
