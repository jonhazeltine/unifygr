---
// A family page is the way into its categories. Like the category pages, it
// shows only what someone can turn up to; everything else sits on the
// specialised list.
import Interior from "../../layouts/Interior.astro";
import MinistryCard from "../../components/MinistryCard.astro";
import MinistryMap from "../../components/MinistryMap.astro";
import {
	allFamiliesIncludingSpecialised as families,
	entriesInCategory,
	entriesInFamily,
	splitOffering,
	newLifeNote,
	sortEntries,
	type Family,
} from "../../data/ministries";

export function getStaticPaths() {
	return families.map((family) => ({
		params: { family: family.slug },
		props: { family },
	}));
}

const { family } = Astro.props as { family: Family };

const { offering, specialized } = splitOffering(sortEntries(entriesInFamily(family.slug)));

const groups = family.categories
	.map((category) => {
		const open = splitOffering(sortEntries(entriesInCategory(category.slug))).offering;
		return {
			category,
			signature: open.filter((e) => e.house === "in"),
			curated: open.filter((e) => e.house === "out"),
			entries: open,
		};
	})
	.filter((g) => g.entries.length > 0);

const openCategories = family.categories.filter(
	(c) => splitOffering(entriesInCategory(c.slug)).offering.length === 0,
);
---

<Interior
	title={`${family.name} | Ministries | New Life Grand Rapids`}
	description={family.blurb}
	kicker="Ministries"
	heading={family.name}
	lede={family.blurb}
>
	<section class="section">
		<div class="container">
			<p class="min-breadcrumb reveal is-visible">
				<a href="/ministries">All ministries</a> · {offering.length}
				{offering.length === 1 ? " offering" : " offerings"} across {family.categories.length} categories
				{offering.length > 0 && <> · <a href="/ministries/calendar">on our calendar</a></>}
			</p>

			{newLifeNote(undefined, family.slug) && (
				<div class="min-usnote reveal is-visible">
					<p class="eyebrow">Where we stand</p>
					<p>{newLifeNote(undefined, family.slug)}</p>
				</div>
			)}

			{offering.some((e) => e.house === "out") && (
				<div class="min-mapblock reveal is-visible">
					<h2 class="min-mapblock__title">Where can I connect?</h2>
					<MinistryMap entries={offering} label={family.name} />
				</div>
			)}

			{groups.map(({ category, signature, curated }) => (
				<div class="min-cat reveal is-visible">
					<div class="min-cat__head">
						<h2 id={category.slug}>
							<a href={`/ministries/${family.slug}/${category.slug}`}>{category.name}</a>
						</h2>
						<span>{signature.length + curated.length}</span>
						<a class="min-cat__more" href={`/ministries/${family.slug}/${category.slug}`}>
							Map &amp; calendar →
						</a>
					</div>
					{signature.length > 0 && (
						<>
							<p class="min-subhead">Signature — we lead it, our volunteers run it</p>
							<div class="min-grid">
								{signature.map((entry) => <MinistryCard entry={entry} full={true} />)}
							</div>
						</>
					)}
					{curated.length > 0 && (
						<>
							<p class="min-subhead">Curated — led by another ministry, chosen by us</p>
							<div class="min-grid">
								{curated.map((entry) => <MinistryCard entry={entry} full={true} />)}
							</div>
						</>
					)}
				</div>
			))}

			{specialized.length > 0 && (
				<p class="min-shelf reveal is-visible">
					{specialized.length} specialised {specialized.length === 1 ? "ministry works" : "ministries work"}
					{" "}in this area too. They do not publish dates we can carry, so they sit on the
					{" "}<a href="/ministries/specialized">specialised list</a>.
				</p>
			)}

			{openCategories.length > 0 && (
				<div class="min-gaps reveal is-visible">
					<h2>Still open</h2>
					<p>
						Nothing with dates we can carry in these yet. If you know a ministry that does one of
						them well, that is exactly what we are looking for.
					</p>
					<ul>
						{openCategories.map((category) => (
							<li>
								<a href={`/ministries/${family.slug}/${category.slug}`}>{category.name}</a>
							</li>
						))}
					</ul>
					<a class="button button--secondary" href="/connect">
						Suggest a ministry
					</a>
				</div>
			)}
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="min-next reveal is-visible">
				{families
					.filter((f) => f.slug !== family.slug)
					.slice(0, 4)
					.map((f) => (
						<a href={`/ministries/${f.slug}`}>
							<strong>{f.name}</strong>
							<span>{f.categories.length} categories</span>
						</a>
					))}
			</div>
		</div>
	</section>
</Interior>
