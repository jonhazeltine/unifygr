---
import Interior from "../../layouts/Interior.astro";
import { calendar, type CalendarEvent as Ev } from "../../lib/partners/calendar";
import { entries } from "../../data/ministries";
import { church } from "../../data/site";

// Built on every request from the churches we carry and the kinds of gathering
// we take from each, both set at /studio/partners. A church that posts a new
// date is on this page the same day, with nothing to rebuild.
export const prerender = false;

const data = await calendar();
// Fresh within a few minutes, but served from cache like a static page. A
// switch flipped in the partners panel shows here within five minutes.
Astro.response.headers.set("cache-control", "public, s-maxage=300, stale-while-revalidate=3600");

// Our own weekly rhythms sit in the same list as everything else, because it is
// one calendar.
const ours = entries
	.filter((e) => e.house === "in" && e.rhythm && e.status === "live")
	.map((e) => ({ name: e.name, rhythm: e.rhythm!, slug: e.slug }));

const byDate = new Map<string, Ev[]>();
for (const ev of data.events) {
	if (!byDate.has(ev.date)) byDate.set(ev.date, []);
	byDate.get(ev.date)!.push(ev);
}
const days = [...byDate.entries()].sort((a, b) => a[0].localeCompare(b[0])).slice(0, 21);

// Every count on this page describes exactly what is printed below it, not the
// whole snapshot.
const shown = days.flatMap(([, list]) => list);
const themeCounts = new Map<string, { label: string; n: number }>();
for (const ev of shown) {
	const seen = themeCounts.get(ev.theme) ?? { label: ev.themeLabel, n: 0 };
	themeCounts.set(ev.theme, { label: seen.label, n: seen.n + 1 });
}
const themes = [...themeCounts.entries()]
	.map(([slug, v]) => ({ slug, ...v }))
	.sort((a, b) => b.n - a.n || a.label.localeCompare(b.label));

// Sixteen pills is a wall on a phone. Show the busiest few and let people open
// the rest.
const PILLS = 6;

function label(iso: string) {
	const d = new Date(`${iso}T12:00:00`);
	return {
		weekday: d.toLocaleDateString("en-US", { weekday: "long" }),
		day: d.toLocaleDateString("en-US", { month: "long", day: "numeric" }),
	};
}

const venues = new Set(shown.map((e) => e.venue).filter(Boolean));
---

<Interior
	title="Our Calendar | New Life Grand Rapids"
	description="One calendar for everything our church family is doing, wherever it meets."
	kicker="Ministries"
	heading="Our Calendar"
	lede="Everything our family is doing over the coming weeks, whichever building it happens in."
>
	<section class="section">
		<div class="container">
			<div class="min-calbar reveal is-visible">
				<div>
					<strong>{shown.length}</strong>
					<span>gatherings coming up</span>
				</div>
				<div>
					<strong>{venues.size}</strong>
					<span>places we meet</span>
				</div>
				<div>
					<strong>{ours.length}</strong>
					<span>of them at Knapp's Corner</span>
				</div>
			</div>
			<div class="min-themes reveal is-visible" data-themefilter>
				<button class="min-theme is-active" type="button" data-theme="" aria-pressed="true">
					Everything
				</button>
				{themes.map((t, i) => (
					<button
						class={i < PILLS ? "min-theme" : "min-theme min-theme--extra"}
						type="button"
						data-theme={t.slug}
						aria-pressed="false"
					>
						<strong>{t.n}</strong> {t.label}
					</button>
				))}
				{themes.length > PILLS && (
					<button class="min-theme min-theme--more" type="button" data-more>
						+{themes.length - PILLS} more
					</button>
				)}
			</div>
			<p class="lead-copy reveal is-visible">
				One calendar for the whole family, wherever a gathering happens to meet. Every date here is
				one we chose for you, and the church underneath it is simply the address.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">What's on</p>
				<h2>The next few weeks.</h2>
			</div>

			{days.length === 0 ? (
				<p class="lead-copy reveal is-visible">
					Nothing is loaded right now. The calendar refreshes when the site is rebuilt.
				</p>
			) : (
				<div class="min-days reveal is-visible">
					{days.map(([iso, list]) => {
						const l = label(iso);
						return (
							<div class="min-day">
								<div class="min-day__head">
									<span class="min-day__weekday">{l.weekday}</span>
									<span class="min-day__date">{l.day}</span>
								</div>
								<ul class="min-day__events">
									{list.map((ev) => (
										<li data-theme={ev.theme}>
											<span class="min-ev__time">{ev.time ?? "All day"}</span>
											<span class="min-ev__body">
												<span class="min-ev__title">{ev.title}</span>
												{ev.venue && (
													<span class="min-ev__venue">
														at {ev.venue}{ev.city ? `, ${ev.city}` : ""}
													</span>
												)}
											</span>
											<span class="min-ev__area">{ev.themeLabel}</span>
										</li>
									))}
								</ul>
							</div>
						);
					})}
				</div>
			)}
		</div>
	</section>

	<section class="section prose-block prose-block--tinted">
		<div class="container">
			<p class="eyebrow reveal is-visible">Adding to it</p>
			<h2 class="prose-block__title reveal is-visible">More of the family, on here.</h2>
			<div class="prose-block__body">
				<p class="reveal is-visible">
					Right now this calendar carries the ministries whose dates we can read automatically. Every
					time another one of ours starts publishing a calendar we can follow, their gatherings
					appear here beside the rest without anybody retyping anything.
				</p>
				<p class="reveal is-visible">
					If you lead one of these ministries and keep a calendar, we would like to carry it.
				</p>
			</div>
			<div class="min-cta reveal is-visible">
				<a class="button button--primary" href="/ministries">All ministries</a>
				<a class="button button--secondary" href={church.external.churchesCalendar} target="_blank" rel="noopener">
					City-wide calendar
				</a>
			</div>
		</div>
	</section>

	<script>
		// Tapping a theme pill narrows the list below it. Days that empty out drop
		// away, so you never scroll past a header with nothing under it.
		const bar = document.querySelector<HTMLElement>("[data-themefilter]");
		if (bar) {
			const pills = [...bar.querySelectorAll<HTMLButtonElement>(".min-theme[data-theme]")];
			const more = bar.querySelector<HTMLButtonElement>("[data-more]");
			more?.addEventListener("click", () => {
				bar.classList.add("is-expanded");
				more.remove();
			});

			const days = [...document.querySelectorAll<HTMLElement>(".min-day")];
			const apply = (theme: string) => {
				for (const day of days) {
					const rows = [...day.querySelectorAll<HTMLElement>("li[data-theme]")];
					let last: HTMLElement | null = null;
					for (const row of rows) {
						const show = !theme || row.dataset.theme === theme;
						row.hidden = !show;
						row.classList.remove("is-last");
						if (show) last = row;
					}
					last?.classList.add("is-last");
					day.hidden = last === null;
				}
				for (const pill of pills) {
					const on = (pill.dataset.theme ?? "") === theme;
					pill.classList.toggle("is-active", on);
					pill.setAttribute("aria-pressed", String(on));
				}
			};

			for (const pill of pills) {
				pill.addEventListener("click", () => {
					const own = pill.dataset.theme ?? "";
					apply(own && pill.classList.contains("is-active") ? "" : own);
				});
			}
		}
	</script>
</Interior>
