---
import Interior from "../../layouts/Interior.astro";
import MinistryCard from "../../components/MinistryCard.astro";
import MinistryMap from "../../components/MinistryMap.astro";
import {
	families,
	standard,
	counts,
	inHouse,
	outOfHouse,
	familyCount,
	familyCalendarCount,
	withLiveCalendar,
	sortEntries,
} from "../../data/ministries";

const signature = sortEntries(inHouse).filter((e) => e.tier === "signature");
const live = withLiveCalendar();
---

<Interior
	title="Ministries | New Life Grand Rapids"
	description="Ministries we lead, and ministries across Grand Rapids we trust enough to send you to."
	kicker="Signature Ministries & Curated Partnerships"
	heading="Ministries"
	lede="One church, meeting in a lot of different rooms. Everything here is open to you."
>
	<!-- One body, many rooms -->
	<section class="section prose-block">
		<div class="container">
			<p class="eyebrow reveal is-visible">One body, many rooms</p>
			<h2 class="prose-block__title reveal is-visible">The church in this city is bigger than our building.</h2>
			<div class="prose-block__body">
				<p class="reveal is-visible">
					{counts.inHouse} of these ministries meet at Knapp's Corner. The other {counts.outOfHouse} meet in
					buildings across the city, led by brothers and sisters. They sit on this page beside our own
					because that is what they are: ours.
				</p>
				<p class="reveal is-visible">
					Each one keeps its own leaders and its own front door. When something here meets somewhere
					else, that is an address, not a distance.
				</p>
			</div>
		</div>
	</section>

	<!-- Two halves -->
	<section class="section">
		<div class="container">
			<div class="min-halves reveal is-visible">
				<a class="min-half" href="#signature">
					<span class="min-half__label">At Knapp's Corner</span>
					<strong class="min-half__title">Signature Ministries</strong>
					<span class="min-half__count">{counts.inHouse}</span>
					<p>Worship, prayer, our kids, our people, and the mission trips we have led since 2015.</p>
					<span class="min-half__go">See what we lead →</span>
				</a>
				<a class="min-half min-half--out" href="#browse">
					<span class="min-half__label">Elsewhere in the city</span>
					<strong class="min-half__title">Curated Partnerships</strong>
					<span class="min-half__count">{counts.outOfHouse}</span>
					<p>The same family, meeting in other rooms across the city.</p>
					<span class="min-half__go">Browse {counts.categories} categories →</span>
				</a>
			</div>
		</div>
	</section>

	<!-- Signature ministries -->
	<section class="section" id="signature">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">At Knapp's Corner</p>
				<h2>What meets in our building.</h2>
			</div>
			<div class="min-grid reveal is-visible">
				{signature.map((entry) => <MinistryCard entry={entry} />)}
			</div>
		</div>
	</section>

	<!-- Browse -->
	<section class="section prose-block prose-block--tinted" id="browse">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">Find what you're looking for</p>
				<h2>Every category, with a map for each.</h2>
			</div>
			<div class="min-families reveal is-visible">
				{families.map((family) => {
					const n = familyCount(family.slug);
					const cal = familyCalendarCount(family.slug);
					return (
						<a class="min-family" href={`/ministries/${family.slug}`}>
							<div class="min-family__head">
								<h3>{family.name}</h3>
								<span class={n ? "min-family__n" : "min-family__n min-family__n--empty"}>
									{n || "—"}
								</span>
							</div>
							<p>{family.blurb}</p>
							<span class="min-family__cats">
								{family.categories.slice(0, 3).map((c) => c.name).join(" · ")}
								{family.categories.length > 3 && ` · +${family.categories.length - 3}`}
							</span>
							{cal > 0 && <span class="min-family__cal">{cal} with a live calendar</span>}
						</a>
					);
				})}
			</div>
		</div>
	</section>

	<!-- The whole map -->
	<section class="section" id="geography">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">Where they are</p>
				<h2>Close enough to actually go.</h2>
			</div>
			<div class="reveal is-visible">
				<MinistryMap entries={outOfHouse} map="all" label="every curated ministry" />
			</div>
		</div>
	</section>

	<!-- Curated calendar -->
	<section class="section prose-block prose-block--tinted">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">What's coming up</p>
				<h2>The curated calendar.</h2>
			</div>
			<p class="lead-copy reveal is-visible">
				One calendar for the whole family, wherever a gathering happens to meet. We carry the ones we
				have chosen, not everything that goes on in these buildings.
			</p>
			<div class="min-cta reveal is-visible">
				<a class="button button--primary" href="/ministries/calendar">Open the calendar</a>
				<a class="button button--secondary" href="/ministries/specialized">Specialised ministries</a>
				<a class="button button--secondary" href="/unify-gr#calendar">City-wide calendar</a>
			</div>
		</div>
	</section>

	<!-- What curated means -->
	<section class="section">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">{standard.eyebrow}</p>
				<h2>We put our name next to these.</h2>
			</div>
			<p class="lead-copy reveal is-visible">
				Nobody pays to be on this list. A ministry is here because we would send our own family to it,
				and you get a first step in plain English rather than a link and good luck.
			</p>
			<div class="min-tests reveal is-visible">
				{standard.tests.map((test, i) => (
					<div class="min-test">
						<span class="min-test__n">{String(i + 1).padStart(2, "0")}</span>
						<h3>{test.name}</h3>
						<p>{test.short}</p>
					</div>
				))}
			</div>
			<div class="min-note reveal is-visible">
				<p>
					<strong>Where this stands.</strong> {counts.outOfHouse} ministries are listed and
					{" "}{counts.awaitingVerification} are still waiting on a conversation with someone here, which
					their cards say plainly. {counts.uncovered} categories have nobody in them yet. If you lead
					one of these ministries, or know one we are missing, tell us.
				</p>
				<a class="button button--secondary" href="https://newlife.ccbchurch.com/goto/forms/156/responses/new">
					Tell us about a ministry
				</a>
			</div>
		</div>
	</section>
</Interior>
