---
import Interior from "../../layouts/Interior.astro";
import MinistryCard from "../../components/MinistryCard.astro";
import {
	allFamiliesIncludingSpecialised,
	entries,
	families,
	standard,
	counts,
	inHouse,
	outOfHouse,
	familyCount,
	familyImage,
	familyCalendarCount,
	withLiveCalendar,
	isOffering,
	isListable,
	entriesInFamily,
	entriesInCategory,
	sortEntries,
} from "../../data/ministries";
import curatedEventsJson from "../../../content/curated-events.json";

const curatedEvents = (curatedEventsJson.events ?? []) as unknown[];

const signature = sortEntries(inHouse).filter((e) => e.tier === "signature");
const live = withLiveCalendar();

// The scale is the first thing a visitor should meet, so it is counted from the
// directory itself rather than typed into the copy where it would rot.
const allOfferings = entries.filter((e) => isOffering(e) && isListable(e));
const offeringCount = allOfferings.length;
const areaCount = new Set(allOfferings.flatMap((e) => e.categories)).size;
const gatheringCount = curatedEvents.length;

// Curated needs a section of its own. Sending it to the category browse landed
// people in a mixed list with our own ministries in it.
const curatedOfferings = sortEntries(outOfHouse.filter((e) => isOffering(e) && isListable(e)));

const curatedByFamily = allFamiliesIncludingSpecialised
	.map((family) => {
		const slugs = new Set(family.categories.map((c) => c.slug));
		return {
			family,
			list: sortEntries(
				outOfHouse.filter(
					(e) => isOffering(e) && isListable(e) && e.categories.some((c) => slugs.has(c)),
				),
			),
		};
	})
	.filter((g) => g.list.length > 0);
---

<Interior
	title="Ministries | New Life Grand Rapids"
	description="Ministries we lead, and ministries across Grand Rapids we trust enough to send you to."
	kicker="Ministries"
	heading="Ministries"
	lede="Whatever season you are in, there is something here for you and for the people you love."
>
	<!-- The number, first, because it is the point -->
	<section class="section min-scale">
		<div class="container">
			<div class="min-scale__band reveal is-visible">
				<div>
					<strong>{offeringCount}</strong>
					<span>ministries you can join</span>
				</div>
				<div>
					<strong>{areaCount}</strong>
					<span>areas of life they cover</span>
				</div>
				<div>
					<strong>{gatheringCount}</strong>
					<span>gatherings already on the calendar</span>
				</div>
			</div>
			<p class="min-scale__line reveal is-visible">
				No single church in Grand Rapids offers this much. We do not either. We offer what the whole
				Body offers, because it was never meant to be carried by one congregation.
			</p>
		</div>
	</section>

	<!-- The welcome -->
	<section class="section prose-block">
		<div class="container">
			<p class="eyebrow reveal is-visible">You are welcome here</p>
			<h2 class="prose-block__title reveal is-visible">A whole life, not a slot in a programme.</h2>
			<div class="prose-block__body">
				<p class="reveal is-visible">
					People do not arrive at a church in pieces. You come with a marriage or the ache of not
					having one, with a toddler who will not sit still, with a teenager you are losing sleep
					over, with a job that ended, with a body that is failing, with a faith that is either
					growing or quietly going cold.
				</p>
				<p class="reveal is-visible">
					So we went looking for all of it. Not the parts that are convenient for us to run, and not
					the parts that make us look good. Every season a family actually goes through, and someone
					in this city who does that season well.
				</p>
				<p class="reveal is-visible">
					We want your family to flourish more than we want your attendance. If the best thing for
					you meets in somebody else's building on a Tuesday night, we would rather tell you where it
					is than pretend we have it.
				</p>
			</div>
		</div>
	</section>

	<!-- How we think about this -->
	<section class="section prose-block">
		<div class="container">
			<p class="eyebrow reveal is-visible">How we think about this</p>
			<h2 class="prose-block__title reveal is-visible">If we cannot tell you when it meets, it is not here.</h2>
			<div class="prose-block__body">
				<p class="reveal is-visible">
					Some of what follows is ours. We lead it, our volunteers run it, and we give it everything
					we have. The rest is led by people we trust across the city, and it sits here beside our own
					because that is what the Body is.
				</p>
				<p class="reveal is-visible">
					Everything on this page has real dates. If we cannot tell you when it meets, it is not here.
					A ministry you cannot turn up to is a fact, not an offer.
				</p>
			</div>
		</div>
	</section>

	<!-- Browse -->
	<section class="section" id="ministries">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">The ministries</p>
				<h2>Everything on offer, by area.</h2>
			</div>
			<div class="min-families reveal is-visible">
				{families.map((family) => {
					const n = familyCount(family.slug);
					const inArea = entriesInFamily(family.slug).filter(isOffering);
					const sig = inArea.filter((e) => e.house === "in").length;
					const cur = inArea.length - sig;
					return (
						<a class="min-family" href={`/ministries/${family.slug}`}>
							{familyImage(family.slug) && (
								<span class="min-family__art" aria-hidden="true">
									<img src={familyImage(family.slug)} alt="" loading="lazy" decoding="async" />
								</span>
							)}
							<div class="min-family__head">
								<h3>{family.name}</h3>
								<span class={n ? "min-family__n" : "min-family__n min-family__n--empty"}>
									{n || "—"}
								</span>
							</div>
							<p>{family.blurb}</p>
							<ul class="min-family__breakdown">
								{family.categories
									.map((c) => ({ c, n: entriesInCategory(c.slug).filter(isOffering).length }))
									.filter(({ n }) => n > 0)
									.sort((a, b) => b.n - a.n || a.c.name.localeCompare(b.c.name))
									.slice(0, 6)
									.map(({ c, n }) => (
										<li>
											<span>{c.name}</span>
											<em>{n}</em>
										</li>
									))}
							</ul>
							<span class="min-family__mix">
								{sig > 0 && <em>{sig} ours</em>}
								{sig > 0 && cur > 0 && " · "}
								{cur > 0 && <span>{cur} curated</span>}
							</span>
						</a>
					);
				})}
			</div>
		</div>
	</section>

	<!-- Curated calendar -->
	<section class="section prose-block prose-block--tinted">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">What's coming up</p>
				<h2>The curated calendar.</h2>
			</div>
			<p class="lead-copy reveal is-visible">
				One calendar for the whole family, wherever a gathering happens to meet. We carry the ones we
				have chosen, not everything that goes on in these buildings.
			</p>
			<div class="min-cta reveal is-visible">
				<a class="button button--primary" href="/ministries/calendar">Open the calendar</a>
				<a class="button button--secondary" href="/ministries/specialized">Specialised ministries</a>
				<a class="button button--secondary" href="/unify-gr#calendar">City-wide calendar</a>
			</div>
		</div>
	</section>

	<!-- What curated means -->
	<section class="section">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">{standard.eyebrow}</p>
				<h2>We put our name next to these.</h2>
			</div>
			<p class="lead-copy reveal is-visible">
				Nobody pays to be on this list. A ministry is here because we would send our own family to it,
				and you get a first step in plain English rather than a link and good luck.
			</p>
			<div class="min-tests reveal is-visible">
				{standard.tests.map((test, i) => (
					<div class="min-test">
						<span class="min-test__n">{String(i + 1).padStart(2, "0")}</span>
						<h3>{test.name}</h3>
						<p>{test.short}</p>
					</div>
				))}
			</div>
			<div class="min-note reveal is-visible">
				<p>
					<strong>Where this stands.</strong> {counts.outOfHouse} ministries are listed and
					{" "}{counts.awaitingVerification} are still waiting on a conversation with someone here, which
					their cards say plainly. {counts.uncovered} categories have nobody in them yet. If you lead
					one of these ministries, or know one we are missing, tell us.
				</p>
				<a class="button button--secondary" href="https://newlife.ccbchurch.com/goto/forms/156/responses/new">
					Tell us about a ministry
				</a>
			</div>
		</div>
	</section>
</Interior>
