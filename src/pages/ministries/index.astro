---
import Interior from "../../layouts/Interior.astro";
import SignatureCard from "../../components/SignatureCard.astro";
import { listPages, readPageState } from "../../lib/studio/pages";
import { publicBuilderLink } from "../../lib/studio/page-links";

export const prerender = false;
import {
	allFamiliesIncludingSpecialised,
	classifyFamilies,
	standard,
	familyImage,
	familyCalendarCount,
	isOffering,
	isListable,
	sortEntries,
} from "../../data/ministries";
import { approvedFamilyArt } from "../../data/ministry-art-approvals";
import { pillars } from "../../data/site";
import { runtimeDirectoryEntries } from "../../lib/partners/directory";

const runtimeEntries = await runtimeDirectoryEntries(Astro.locals);
const { families } = classifyFamilies(runtimeEntries);
const inHouse = runtimeEntries.filter((entry) => entry.house === "in");
const outOfHouse = runtimeEntries.filter((entry) => entry.house === "out");
const live = sortEntries(runtimeEntries.filter((entry) => entry.calendar?.sync === "available" || entry.calendar?.sync === "page-current"));
const entriesInFamily = (slug: string) => {
	const family = allFamiliesIncludingSpecialised.find((candidate) => candidate.slug === slug);
	const categories = new Set(family ? family.categories.map((category) => category.slug) : []);
	return runtimeEntries.filter((entry) => entry.categories.some((category) => categories.has(category)) && isListable(entry));
};
const familyCount = (slug: string) => entriesInFamily(slug).filter(isOffering).length;
const listedOfferings = outOfHouse.filter((entry) => isOffering(entry) && isListable(entry));
const awaitingVerification = outOfHouse.filter((entry) => entry.status !== "live" && isListable(entry)).length;
const uncovered = allFamiliesIncludingSpecialised.flatMap((family) => family.categories).filter((category) => !runtimeEntries.some((entry) => entry.categories.includes(category.slug) && isListable(entry))).length;

// Our signature ministries, signature tier first. These open the page on their
// own, no curated
// mixed in, because this section is answering a different question.
// Derived so the sentence below cannot drift from the list above it.
const curatedOffering = outOfHouse.filter((e) => isOffering(e) && isListable(e));
const curatedHosts = new Set(curatedOffering.map((e) => e.venue ?? e.org ?? e.name)).size;
const curatedTowns = new Set(curatedOffering.map((e) => e.city).filter(Boolean)).size;

// Keep Worship and Prayer visually separated; Ambassador Teams represents
// our participation with other churches.
const SIGNATURE_ORDER = [
	"new-life-worship",
	"life-groups",
	"childrens-ministry",
	"pastoral-care",
	"corporate-prayer",
	"mission-of-hope-trips",
	"ambassador-teams",
	"outreach",
];
const signature = inHouse
	.filter((e) => e.tier === "signature" && e.slug !== "unify-gr")
	.sort((a, b) => {
		const ai = SIGNATURE_ORDER.indexOf(a.slug);
		const bi = SIGNATURE_ORDER.indexOf(b.slug);
		return (ai < 0 ? 99 : ai) - (bi < 0 ? 99 : bi) || a.name.localeCompare(b.name);
	});

// Candidate art per signature ministry. The render path below only displays
// entries with an explicitly approved people-first image and native dimensions.
const SIGNATURE_ART: Record<string, string> = {
	"new-life-worship": "/art/ministries/worship-approved.webp",
	"corporate-prayer": "/art/ministries/prayer-pray.webp",
	"life-groups": "/art/ministries/life-groups-approved.webp",
	"childrens-ministry": "/art/ministries/kids.webp",
	"pastoral-care": "/art/ministries/pastoral-care-approved.webp",
	"mission-of-hope-trips": "/art/ministries/mission-approved.webp",
	"ambassador-teams": "/art/ministries/ambassador-approved.webp",
	outreach: "/art/ministries/practical-care.webp",
	"unify-gr": "/art/generated/unity-still.png",
};
const artFor = (slug: string) => SIGNATURE_ART[slug] ?? "/art/generated/gr-city-unity.png";
const approvedSignatureArt: Partial<Record<string, { width: number; height: number }>> = {
	"new-life-worship": { width: 760, height: 286 },
	"corporate-prayer": { width: 1536, height: 1024 },
	"life-groups": { width: 946, height: 479 },
	"pastoral-care": { width: 946, height: 454 },
	"ambassador-teams": { width: 946, height: 563 },
	"childrens-ministry": { width: 730, height: 425 },
	"mission-of-hope-trips": { width: 756, height: 288 },
	outreach: { width: 746, height: 424 },
};

// A ministry can point at a page of its own, but a page that is still a draft
// answers a real 404 to everyone but staff. So the card falls back to the
// ministry's own page until the fuller one is published, and picks the better
// link up on its own the day it is.
const pageStatus = new Map((await listPages(Astro.locals)).map((page) => [page.slug, page.status] as const));
const linkedSlugs = [...new Set(outOfHouse.map((entry) => entry.href?.startsWith("/") ? entry.href.replace(/^\//, "") : "").filter(Boolean))];
const removedBuilderPages = new Set((await Promise.all(linkedSlugs.map(async (slug) =>
	(await readPageState(slug, Astro.locals)) === null ? slug : null,
))).filter((slug): slug is string => Boolean(slug)));
function linkFor(entry: { slug: string; href?: string | null }): string {
	const slug = entry.href?.replace(/^\//, "") ?? "";
	return publicBuilderLink(entry, pageStatus, removedBuilderPages.has(slug));
}

const curatedByFamily = allFamiliesIncludingSpecialised
	.map((family) => {
		const slugs = new Set(family.categories.map((c) => c.slug));
		return {
			family,
			list: sortEntries(
				outOfHouse.filter(
					(e) => isOffering(e) && isListable(e) && e.categories.some((c) => slugs.has(c)),
				),
			),
		};
	})
	.filter((g) => g.list.length > 0);
---

<Interior
	title="Ministries | New Life Grand Rapids"
	description="Where New Life puts its focus, and the best of Grand Rapids opened up for your family."
	kicker="Signature Ministries & Curated Ministries"
	heading="Ministries"
	lede="One church, meeting in a lot of different rooms. Everything here is open to you."
>
	<!-- Our philosophy of ministry -->
	<section class="section prose-block ministry-intro">
		<div class="container">
			<p class="eyebrow reveal is-visible">How we think about this</p>
			<h2 class="prose-block__title reveal is-visible">The Lord has provided everything you need.</h2>
			<blockquote class="min-quote reveal is-visible">
				<p>“His divine power has given us everything we need for a godly life.”</p>
				<cite>2 Peter 1:3</cite>
			</blockquote>
			<div class="prose-block__body">
				<p class="reveal is-visible">
					Everything you need is in Christ, and He usually hands it to you through His people — a
					Tuesday night group, a food pantry, a table of moms who have been exactly where you are.
					Some of that happens in our building. A lot of it happens ten minutes from your kitchen
					table, which is where it ought to be when driving across town is the thing standing in
					your way.
				</p>
				<p class="reveal is-visible">
					So everything on this page has a day, a time, and an address. Take whichever one is
					closest, and just go.
				</p>
			</div>
		</div>
	</section>

	<!-- Our focus: the signature ministries -->
	<section class="section" id="ours">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">Signature ministries</p>
				<h2>Our Focus.</h2>
			</div>
			<div class="prose-block__body reveal is-visible">
				<p>New Life is a place where people will encounter God, be transformed, and change the world.</p>
			</div>
			<div class="min-tests reveal is-visible">
				{pillars.map((pillar) => (
					<a class="min-test" href={`/${pillar.slug}`}>
						<h3>{pillar.title}</h3>
						<p>{pillar.essence}</p>
					</a>
				))}
			</div>
			<div class="prose-block__body reveal is-visible">
				<p>
					Sunday morning at 10 at 2777 Knapp. Prayer. Life Groups meeting weekly in homes across
					the city. Our kids, and the people who show up at the hospital. Teams going overseas,
					to another church in this city, and out onto our own street.
				</p>
				<p>
					These {signature.length} are where our focus goes, and every one of them is open to
					anyone in the city.
				</p>
			</div>
			<div class="sig-grid reveal is-visible">
				{signature.map((entry) => {
					const imageSize = approvedSignatureArt[entry.slug];
					// Only the explicitly approved people imagery belongs in this light
					// ministry presentation. New concepts arrive through human review.
					return <SignatureCard entry={entry} image={imageSize ? artFor(entry.slug) : undefined} imageSize={imageSize} href={linkFor(entry)} light />;
				})}
			</div>

		</div>
	</section>

	<!-- Everything else we carry for you -->
	<section class="section" id="ministries">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">Everything else</p>
				<h2>The best resources the body of Christ has to offer</h2>
			</div>
			<div class="prose-block__body reveal is-visible">
				<p>
					The deepest discipleship, the strongest care, the
					challenge that will actually stretch you, and the group where your daughter will be
					known by name. We found {listedOfferings.length} of them, run by {curatedHosts} churches
					and ministries across {curatedTowns} towns.
				</p>
				<p>
					Then we built you a way in. Every one of these has a day, a time, an address near
					somebody's home, and a first step in plain English. We chose each one ourselves and we
					send our own families to them.
				</p>
				<p>
					Your family gets all of it, and we are watching to see that every need is met and
					nothing is missed.
				</p>
			</div>
			<div class="min-families reveal is-visible">
				{families.map((family) => {
					const approvedArt = approvedFamilyArt[family.slug];
					const n = familyCount(family.slug);
					const inArea = entriesInFamily(family.slug).filter(isOffering);
					const sig = inArea.filter((e) => e.house === "in").length;
					const cur = inArea.length - sig;
					return (
						<a class="min-family" href={`/ministries/${family.slug}`}>
							{approvedArt && familyImage(family.slug) ? (
								<span class:list={["min-family__art", "min-family__art--approved", { "min-family__art--pair": approvedArt.extraImages?.length }]} aria-hidden="true">
									<img src={familyImage(family.slug)} alt="" loading="lazy" decoding="async" />
									{approvedArt.extraImages?.map((image) => (
										<img src={image.src} alt="" loading="lazy" decoding="async" />
									))}
								</span>
							) : <span class="min-family__art min-family__art--placeholder" aria-hidden="true"></span>}
							<div class="min-family__head">
								<h3>{family.name}</h3>
								<span class={n ? "min-family__n" : "min-family__n min-family__n--empty"}>
									{n || "—"}
								</span>
							</div>
							<p>{family.blurb}</p>
							<span class="min-family__cats">
								{family.categories.slice(0, 3).map((c) => c.name).join(" · ")}
								{family.categories.length > 3 && ` · +${family.categories.length - 3}`}
							</span>
							<span class="min-family__mix">
								{sig > 0 && <em>{sig} signature (ours)</em>}
								{sig > 0 && cur > 0 && " · "}
								{cur > 0 && <span>{cur} curated (hosted)</span>}
							</span>
						</a>
					);
				})}
			</div>
		</div>
	</section>

	<!-- Curated calendar -->
	<section class="section prose-block prose-block--tinted">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">What's coming up</p>
				<h2>The curated calendar.</h2>
			</div>
			<p class="lead-copy reveal is-visible">
				One calendar for the whole family, wherever a gathering happens to meet. Every date we have
				chosen for you, in one place.
			</p>
			<div class="min-cta reveal is-visible">
				<a class="button button--primary" href="/ministries/calendar">Open the calendar</a>
				<a class="button button--secondary" href="/ministries/specialized">Specialised ministries</a>
				<a class="button button--secondary" href="/unify-gr#calendar">City-wide calendar</a>
			</div>
		</div>
	</section>

	<!-- What curated means -->
	<section class="section">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">{standard.eyebrow}</p>
				<h2>How we choose.</h2>
			</div>
			<p class="lead-copy reveal is-visible">
				A ministry is here because we would send our own family to it. Then we do the work of
				finding out when it meets, where it is, and what your first step looks like.
			</p>
			<div class="min-tests reveal is-visible">
				{standard.tests.map((test, i) => (
					<div class="min-test">
						<span class="min-test__n">{String(i + 1).padStart(2, "0")}</span>
						<h3>{test.name}</h3>
						<p>{test.short}</p>
					</div>
				))}
			</div>
			<div class="min-note reveal is-visible">
				<p>
					<strong>Where this stands.</strong> {listedOfferings.length} ministries are listed and
					{" "}{awaitingVerification} are still waiting on a conversation with someone here, which
					their cards say plainly. {uncovered} categories have nobody in them yet. If you lead
					one of these ministries, or know one we are missing, tell us.
				</p>
				<a class="button button--secondary" href="/connect">
					Tell us about a ministry
				</a>
			</div>
		</div>
	</section>
</Interior>

<style>
  .ministry-intro { padding-block: 2rem; }
  #ours { padding-top: 2rem; }
</style>
