---
// Meals of Hope — brought across from the old site's /get-involved page.
// Blockified: content lives in content/pages/meals-of-hope.json and is edited
// in the Page Builder (/studio/builder). Starts as a draft — staff-only until
// someone flips it live.
export const prerender = false;
import MountedPage from "../components/builder/MountedPage.astro";
import { draftGuard } from "../lib/studio/pages";
import { isAuthed } from "../lib/studio/auth";

// A draft is staff-only, and answers a real 404 to everyone else.
const notFound = await draftGuard("meals-of-hope", isAuthed(Astro.cookies));
if (notFound) return notFound;
---

<MountedPage slug="meals-of-hope" />
