---
// The tap page — one screen, one thumb, three destinations.
//
// Blockified: the buttons and their links live in content/pages/tap.json and
// are edited in the Page Builder (/studio/builder), so staff can repoint any
// button without a developer. `bare` drops the header and footer — a menu
// would be one more thing to read before the first button.
export const prerender = false;
import MountedPage from "../components/builder/MountedPage.astro";
import { draftGuard } from "../lib/studio/pages";
import { isAuthed } from "../lib/studio/auth";

// A draft is staff-only, and answers a real 404 to everyone else.
const notFound = await draftGuard("tap", isAuthed(Astro.cookies));
if (notFound) return notFound;
---

<MountedPage slug="tap" bare />
