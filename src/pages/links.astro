---
// The /links page — our own "link in bio" page, replacing the Clearstream
// microsite (newlifegr.cls.co) that used to be linked from Instagram/etc.
//
// Blockified like /tap and /next-steps: the buttons and their links live in
// content/pages/links.json and are edited in the Page Builder
// (/studio/builder), so staff can add/reorder/repoint links with no code.
export const prerender = false;
import MountedPage from "../components/builder/MountedPage.astro";
import { draftGuard } from "../lib/studio/pages";
import { isAuthed } from "../lib/studio/auth";

// A draft is staff-only, and answers a real 404 to everyone else.
const notFound = await draftGuard("links", isAuthed(Astro.cookies), Astro.locals);
if (notFound) return notFound;
---

<MountedPage slug="links" bare />
