---
import Site from "../layouts/Site.astro";

export const prerender = false;

// Everything about the community lives behind this one door, so the top
// level of the site can stay about the visitor's decision.
const sections = [
	{ title: "Our staff", line: "The people who lead and care for this community.", href: "/staff" },
	{ title: "Vision and values", line: "Where we are headed and what we hold to.", href: "/vision-values" },
	{ title: "Growth Track", line: "A clear, personal path for growing in Christ.", href: "/spiritual-formation" },
];
---

<Site
	title="About New Life Grand Rapids"
	description="Who leads this community, what we are aiming at, and how to go deeper than a Sunday."
>
	<section class="pagehead">
		<div class="shell">
			<h1>About us</h1>
			<p>
				If you have already decided about Sunday and want to know more about the community itself,
				this is where the rest of it lives.
			</p>
		</div>
	</section>

	<section class="band">
		<div class="shell">
			<div class="vision">
				{sections.map((s) => (
					<a class="vision__item" href={s.href}>
						<strong>{s.title}</strong>
						<span>{s.line}</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="band band--raised">
		<div class="shell">
			<p class="band__label">Start here instead</p>
			<h2 class="band__title">Never been on a Sunday?</h2>
			<a class="btn btn--gold" href="/sunday">What a Sunday is like</a>
		</div>
	</section>
</Site>
