---
import Interior from "../layouts/Interior.astro";
import ValueCard from "../components/ValueCard.astro";
import { vision, values, pillars, runtimeSite } from "../data/site";

export const prerender = false;

const { mission } = await runtimeSite(Astro.locals);
---

<Interior
	title="New Life | Vision, Mission & Values"
	description="The vision, mission, and values of New Life Grand Rapids."
	kicker="About New Life"
	heading="Vision, Mission & Values"
	lede="Where we're headed, and what we hold dear."
>
    <section class="section mission-statement" aria-labelledby="mission-heading">
      <div class="container">
        <p class="eyebrow" id="mission-heading">Our Mission</p>
        <h2 class="mission-statement__words">Hear His voice.<br />Obey His assignments.<br />Unite the Church.<br />Reveal Jesus to the city.</h2>
      </div>
    </section>
	<section class="section">
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">Our Vision</p>
				<h2>Three movements of one life.</h2>
			</div>
			<div class="vision-grid">
				{vision.map((v, i) => {
					const slug = pillars[i].slug;
					const verbs = mission.filter((m) => m.pillar === slug);
					return (
						<a class="vision-card vision-card--panorama reveal is-visible" href={`/${slug}`} style={`--delay:${i * 90}ms`}>
							<img class="vision-card__art" src={`/art/vision/${slug}.webp`} width="2172" height="724" alt="" loading="lazy" />
                            <div class="vision-card__copy">
                            <h3>{v.title}</h3>
							<p>{v.body}</p>
							<ul class="vision-card__mission">
								{verbs.map((m) => (
									<li><span class="vision-card__n">{m.n}</span>{m.verb}</li>
								))}
							</ul>
							<span class="vision-card__go">Explore →</span>
                            </div>
						</a>
					);
				})}
			</div>
		</div>
	</section>

	<section class="section section--rhythm">
		<div class="rhythm__veil"></div>
		<div class="container">
			<div class="section-heading reveal is-visible">
				<p class="eyebrow">Our Values</p>
				<h2>What we hold dear.</h2>
			</div>
			<div class="value-grid">
				{values.map((v, i) => (
					<ValueCard title={v.title} body={v.body} index={i} visible />
				))}
			</div>
		</div>
	</section>
</Interior>

<style>
  .mission-statement { padding-block: clamp(2.5rem, 6vw, 5rem); border-block: 1px solid var(--line); background: linear-gradient(120deg, rgba(207,173,112,.09), transparent 75%); }
  .mission-statement__words { margin: 1rem 0 0; max-width: none; font-family: "Iowan Old Style", Georgia, serif; font-size: clamp(1.75rem, 4.4vw, 3.6rem); line-height: 1.25; color: var(--text); }

  .vision-grid { grid-template-columns: 1fr; }
  .vision-card--panorama { position: relative; isolation: isolate; overflow: hidden; min-height: 400px; padding: 2rem; justify-content: center; }
  .vision-card__art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: -2; }
  .vision-card--panorama::before { content: ""; position: absolute; inset: 0; z-index: -1; background: rgba(5,10,18,.70); }
  .vision-card__copy { max-width: 740px; text-shadow: 0 2px 8px rgba(0,0,0,.6); }
  .vision-card__copy > p { color: #eee6d9; margin-top: .6rem; line-height: 1.6; }
  .vision-card__go { display: block; }
  @media (max-width: 760px) {
    .vision-card--panorama { padding: 1.4rem; min-height: 400px; }
    .vision-card__art { object-position: 60% center; }
  }
</style>
