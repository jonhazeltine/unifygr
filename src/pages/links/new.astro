---
// The /links/new page (slug "new") — everything a first-time visitor needs
// for their first few Sundays: the welcome video series, planning a Sunday,
// the calendar, and letting us know they're here.
//
// Blockified: the buttons and their links live in content/pages/new.json and
// are edited in the Page Builder (/studio/builder).
export const prerender = false;
import MountedPage from "../../components/builder/MountedPage.astro";
import { draftGuard } from "../../lib/studio/pages";
import { isAuthed } from "../../lib/studio/auth";

// A draft is staff-only, and answers a real 404 to everyone else.
const notFound = await draftGuard("new", isAuthed(Astro.cookies), Astro.locals);
if (notFound) return notFound;
---

<MountedPage slug="new" bare />
