---
// The /links/grow page (slug "next-steps") — life groups, Growth Track, The
// Formation App. Formerly mounted at /next-steps, then at /links/next-steps;
// both URLs now 301 here forever (see domain-redirects.mjs).
//
// Blockified: the buttons and their links live in content/pages/next-steps.json
// and are edited in the Page Builder (/studio/builder).
export const prerender = false;
import MountedPage from "../../components/builder/MountedPage.astro";
import { draftGuard } from "../../lib/studio/pages";
import { isAuthed } from "../../lib/studio/auth";

// A draft is staff-only, and answers a real 404 to everyone else.
const notFound = await draftGuard("next-steps", isAuthed(Astro.cookies), Astro.locals);
if (notFound) return notFound;
---

<MountedPage slug="next-steps" bare />
