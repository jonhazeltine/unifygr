---
import Site from "../layouts/Site.astro";
import { church, sermons } from "../data/site";
import { service, answers, identity } from "../data/sunday";

// The hero already gives the when and the where, so this list picks up at the
// next thing a stranger wants to know. Everything else is one tap away.
const upFront = answers.filter((a) => !["When is it?", "Where is it?"].includes(a.q));

const latest = sermons[0];

// The three things this church says it exists to do. Kept — but as a quiet
// strip near the end, not as the thing standing between a stranger and the
// service time.
const vision = [
	{ title: "Encounter God", line: "We build our gatherings around God's presence.", href: "/encounter-god" },
	{ title: "Be Transformed", line: "We expect people to actually change.", href: "/be-transformed" },
	{ title: "Change the World", line: "We work with the whole church across this city.", href: "/change-the-world" },
];
---

<Site
	title="New Life Grand Rapids — Sundays at 10am"
	description="A church at 2777 Knapp St NE in Grand Rapids. Sundays at 10am, about 90 minutes, kids welcome, come as you are."
>
	<section class="opener">
		<!-- 18KB, not the 2.4MB original: it sits at half opacity behind a heavy
		     scrim, so there is nothing for the extra detail to do. -->
		<div class="opener__bg" aria-hidden="true">
			<img src="/art/generated/worship-ambient-v5-thumb.webp" alt="" loading="eager" />
		</div>
		<div class="shell">
			<p class="opener__id">New Life — a church in Grand Rapids, built around Jesus.</p>

			<h1 class="opener__when">
				Sundays<br /><em>at 10am</em>
			</h1>

			<p class="opener__where">
				{service.street}
				<span>{service.city}, {service.state} — out at {service.area}</span>
			</p>

			<p class="opener__note">{service.length}. Come as you are. Kids have their own space.</p>

			<div class="opener__actions">
				<a class="btn btn--gold" href={church.mapUrl} target="_blank" rel="noopener">Get directions</a>
				<a class="btn btn--quiet" href="/sunday">What a Sunday is like</a>
			</div>
		</div>
	</section>

	<section class="band band--raised">
		<div class="shell">
			<p class="band__label">Before you come</p>
			<h2 class="band__title">The things people ask us first.</h2>

			<ul class="qa">
				{upFront.map((item) => (
					<li class="qa__item">
						<p class="qa__q">{item.q}</p>
						<p class="qa__a">{item.a}</p>
					</li>
				))}
			</ul>

			<a class="qa__more" href="/sunday">Everything about a Sunday here →</a>
		</div>
	</section>

	<section class="band">
		<div class="shell">
			<p class="band__label">What we believe</p>
			<p class="creed__line">{identity.line}</p>
			<p class="creed__body">{identity.body}</p>
			<a class="qa__more" href="/beliefs">Read the long version →</a>
		</div>
	</section>

	{latest && (
		<section class="band band--raised">
			<div class="shell">
				<p class="band__label">Have a look first</p>
				<h2 class="band__title">Watch a service before you drive over.</h2>
				<a
					class="watch-card"
					href={`https://www.youtube.com/watch?v=${latest.id}`}
					target="_blank"
					rel="noopener"
				>
					<div class="watch-card__still">
						<img src={`https://i.ytimg.com/vi/${latest.id}/hqdefault.jpg`} alt="" loading="lazy" />
						<span class="watch-card__play" aria-hidden="true"><span>▶</span></span>
					</div>
					<div class="watch-card__meta">
						<strong>{latest.title}</strong>
						<span>{latest.date} · about 90 minutes</span>
					</div>
				</a>
				<a class="qa__more" href="/watch">More services →</a>
			</div>
		</section>
	)}

	<section class="band">
		<div class="shell">
			<p class="band__label">Why we do it this way</p>
			<div class="vision">
				{vision.map((v) => (
					<a class="vision__item" href={v.href}>
						<strong>{v.title}</strong>
						<span>{v.line}</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="band band--raised">
		<div class="shell">
			<p class="band__label">Still deciding</p>
			<h2 class="band__title">Ask us anything before you come.</h2>
			<div class="reach">
				<div class="reach__row">
					<a href={`tel:${church.phone.replace(/\./g, "")}`}>{church.phone}</a>
					<p>Call the office on a weekday.</p>
				</div>
				<div class="reach__row">
					<a href={`mailto:${church.email}`}>{church.email}</a>
					<p>We read every one of these.</p>
				</div>
				<div class="reach__row">
					<a href={church.external.connectCard}>Send us a note</a>
					<p>Tell us you're coming and we'll look for you.</p>
				</div>
			</div>
		</div>
	</section>
</Site>
