---
import Site from "../layouts/Site.astro";
import { runtimeSite } from "../data/site";
import { answersForChurch, identity, serviceForChurch, serviceTimeHeading } from "../data/sunday";

export const prerender = false;

const { church, sermons } = await runtimeSite(Astro.locals);
const service = serviceForChurch(church);
const answers = answersForChurch(church);
const serviceHeading = serviceTimeHeading(church.serviceTime);

// The hero already gives the when and the where, so this list picks up at the
// next thing a stranger wants to know. Everything else is one tap away.
const upFront = answers.filter((a) => !["When is it?", "Where is it?"].includes(a.q));

const latest = sermons[0];

// The three pillars stay fixed while the practical expressions of each one
// move past them. This is the vision visitors can actually step into.
const vision = [
	{
		title: "Encounter God",
		line: "Make room to meet with Him.",
		href: "/encounter-god",
		art: "/art/vision/encounter-god.webp",
		lightArt: "/art/vision/encounter-god-light.webp",
		offerings: [
			{ title: "Sunday Worship Experience", href: "/sunday", detail: "Gather with us every Sunday morning." },
			{ title: "Healing Prayer", href: "/ministries/worship-and-prayer/healing-prayer", detail: "Bring your need before the Lord with others." },
			{ title: "Friday Night Encounter: Prayer & Worship", href: "/ministries/worship-and-prayer/worship-nights", detail: "A night set apart to seek His presence together." },
		],
	},
	{
		title: "Be Transformed",
		line: "Let the life of Jesus take root in you.",
		href: "/be-transformed",
		art: "/art/vision/be-transformed.webp",
		lightArt: "/art/vision/be-transformed-light.webp",
		offerings: [
			{ title: "Life Groups", href: "/ministry/life-groups", detail: "Find people who know you and walk with you." },
			{ title: "Spiritual Formation", href: "/spiritual-formation", detail: "Build a clear, personal rhythm of growth." },
			{ title: "Serving Teams", href: "/ministries", detail: "Serve alongside people who are putting love into practice." },
			{ title: "Pastoral Care", href: "/ministry/pastoral-care", detail: "Receive personal care for the places that need healing." },
		],
	},
	{
		title: "Change the World",
		line: "Carry the love of Jesus into the city and the world.",
		href: "/change-the-world",
		art: "/art/vision/change-the-world.webp",
		lightArt: "/art/vision/change-the-world-light.webp",
		offerings: [
			{ title: "Ambassador Teams", href: "/ambassador-teams", detail: "Strengthen other churches across Grand Rapids." },
			{ title: "Outreach Teams", href: "/outreach-teams", detail: "Show up where our neighbors need us." },
			{ title: "Global Missions", href: "/mission-trips", detail: "Go with New Life into the world." },
			{ title: "Impact Prayer & Worship", href: "/ministries/worship-and-prayer/worship-nights", detail: "Pray for the city and worship in the presence of God together." },
		],
	},
];
---

<Site
	title={`${church.name} — ${church.serviceTime}`}
	description={`A church at ${church.address.street} in ${church.address.city}. ${church.serviceTime}, about 90 minutes, kids welcome, come as you are.`}
>
	<section class="opener">
		<!-- An optimized frame from the existing worship ambient keeps the original
		     composition readable behind a restrained text backdrop. -->
		<div class="opener__bg" aria-hidden="true">
			<img src="/art/generated/worship-ambient-v5.webp" alt="" loading="eager" />
		</div>
		<div class="shell">
			<p class="opener__id">New Life — built around Jesus.</p>

			<h1 class="opener__when">
				{serviceHeading.lead}{serviceHeading.emphasis && <><br /><em>{serviceHeading.emphasis}</em></>}
			</h1>

			<p class="opener__where">
				{service.street}
				<span>{service.city}, {service.state} — out at {service.area}</span>
			</p>

			<p class="opener__note">{service.length}. Come as you are. Kids have their own space.</p>

			<div class="opener__actions">
				<a class="btn btn--gold" href={church.mapUrl} target="_blank" rel="noopener">Get directions</a>
				<a class="btn btn--quiet" href="/sunday">What a Sunday is like</a>
			</div>
		</div>
	</section>

	<section class="band band--raised">
		<div class="shell">
			<p class="band__label">Before you come</p>
			<h2 class="band__title">The things people ask us first.</h2>

			<ul class="qa">
				{upFront.map((item) => (
					<li class="qa__item">
						<p class="qa__q">{item.q}</p>
						<p class="qa__a">{item.a}</p>
					</li>
				))}
			</ul>

			<a class="qa__more" href="/sunday">Everything about a Sunday here →</a>
		</div>
	</section>

	<section class="band">
		<div class="shell">
			<p class="band__label">What we believe</p>
			<p class="creed__line">{identity.line}</p>
			<p class="creed__body">{identity.body}</p>
			<a class="qa__more" href="/beliefs">Read the long version →</a>
		</div>
	</section>

	{latest && (
		<section class="band band--raised">
			<div class="shell">
				<p class="band__label">Have a look first</p>
				<h2 class="band__title">Watch a service before you drive over.</h2>
				<a
					class="watch-card"
					href={`https://www.youtube.com/watch?v=${latest.id}`}
					target="_blank"
					rel="noopener"
				>
					<div class="watch-card__still">
						<img src={`https://i.ytimg.com/vi/${latest.id}/maxresdefault.jpg?v=20260909`} alt="" loading="lazy" />
						<span class="watch-card__play" aria-hidden="true"><span>▶</span></span>
					</div>
					<div class="watch-card__meta">
						<strong>{latest.title}</strong>
						<span>{latest.date} · about 90 minutes</span>
					</div>
				</a>
				<a class="qa__more" href="/watch">More services →</a>
			</div>
		</section>
	)}

	<section class="band home-vision">
		<div class="shell">
			<p class="band__label">Our Vision</p>
			<h2 class="band__title home-vision__title">Encounter God. Be Transformed. Change the World.</h2>
			<p class="home-vision__lede">This is the life we are building together. Keep scrolling to see the ways you can step into it.</p>
			<div class="home-vision__steps">
				{vision.map((v) => (
					<article class="home-vision__step">
						<div class="home-vision__art" aria-hidden="true">
							<img class="home-vision__art-dark" src={v.art} alt="" loading="lazy" />
							<img class="home-vision__art-light" src={v.lightArt} alt="" loading="lazy" />
						</div>
						<div class="home-vision__pillar">
							<p class="band__label">{v.title}</p>
							<h3>{v.title}</h3>
							<p>{v.line}</p>
							<a class="qa__more" href={v.href}>Explore {v.title} →</a>
						</div>
						<div class="home-vision__offerings">
							{v.offerings.map((offering, index) => (
								<a class="home-vision__offering" href={offering.href}>
									<span>{String(index + 1).padStart(2, "0")}</span>
									<strong>{offering.title}</strong>
									<p>{offering.detail}</p>
								</a>
							))}
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="band band--raised">
		<div class="shell">
			<p class="band__label">Still deciding</p>
			<h2 class="band__title">Ask us anything before you come.</h2>
			<div class="reach">
				<div class="reach__row">
					<a href={church.external.connectCard}>Send us a note</a>
					<p>Tell us you're coming and we'll look for you.</p>
				</div>
			</div>
		</div>
	</section>
</Site>

<style>
	.home-vision { overflow: clip; }
	.home-vision__title { max-width: 22ch; margin-bottom: .75rem; }
	.home-vision__lede { color: var(--muted); max-width: 42rem; margin-bottom: 3rem; }
	.home-vision__steps { display: grid; gap: 3.5rem; }
	.home-vision__step { position: relative; isolation: isolate; display: grid; gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
	.home-vision__art { position: absolute; inset: 0 -8vw -1rem; z-index: -1; overflow: hidden; pointer-events: none; opacity: .16; mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 82%, transparent 100%); }
	.home-vision__art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 68% center; }
	.home-vision__art-light { opacity: 0; }
	.home-vision__pillar h3 { font-family: var(--display); font-size: clamp(2.3rem, 7vw, 4.6rem); letter-spacing: -.05em; line-height: .96; margin: .25rem 0 .85rem; }
	.home-vision__pillar > p:not(.band__label) { color: var(--muted); font-size: 1.08rem; max-width: 25rem; }
	.home-vision__offerings { display: grid; gap: .7rem; }
	.home-vision__offering { display: grid; grid-template-columns: 2.6rem 1fr; gap: .1rem .8rem; padding: 1.15rem; text-decoration: none; border: 1px solid var(--line); border-radius: 14px; background: color-mix(in srgb, var(--ink-raised) 72%, transparent); transition: transform .18s ease, border-color .18s ease; }
	.home-vision__offering:hover { transform: translateX(.3rem); border-color: var(--gold); }
	.home-vision__offering > span { grid-row: span 2; color: var(--gold); font-size: .75rem; letter-spacing: .12em; padding-top: .2rem; }
	.home-vision__offering strong { font-family: var(--display); font-size: 1.3rem; letter-spacing: -.02em; }
	.home-vision__offering p { color: var(--muted); font-size: .92rem; line-height: 1.45; }
	:global(:root[data-theme="light"]) .home-vision__art { opacity: .30; }
	:global(:root[data-theme="light"]) .home-vision__art-dark { opacity: 0; }
	:global(:root[data-theme="light"]) .home-vision__art-light { opacity: 1; }
	@media (min-width: 760px) {
		.home-vision__steps { gap: 7rem; }
		.home-vision__step { grid-template-columns: minmax(15rem, .9fr) minmax(23rem, 1.1fr); gap: clamp(2rem, 7vw, 7rem); min-height: 68vh; padding-top: 3rem; }
		.home-vision__pillar { position: sticky; top: 7.5rem; align-self: start; }
		.home-vision__offerings { align-content: center; }
	}
</style>
