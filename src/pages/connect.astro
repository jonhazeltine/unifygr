---
import Interior from "../layouts/Interior.astro";
import ConnectEmbed from "../layouts/ConnectEmbed.astro";
import ConnectForm from "../components/connect/ConnectForm.astro";
import { INTERESTS, interestById } from "../lib/connect/routing";
export const prerender = false;

// A link can land here with the reason already chosen — the tap page sends
// people straight to the Ambassador option. An unknown id just falls back to
// the first choice, so a stale link can never land on nothing.
const wanted = interestById(Astro.url.searchParams.get("interest") ?? "")?.id;
const from = Astro.url.searchParams.get("from")?.slice(0, 40) ?? "";
const picked = wanted;

// ?embed=1 renders the same form for an <iframe> on a tap/next-steps button
// (see TapButtons in blocks.tsx) — no header, nav, footer or Studio dock, and
// nothing that would navigate the frame away. Without it, this page is
// unchanged.
const isEmbed = Astro.url.searchParams.get("embed") === "1";

// Group the direct choices so the form remains easy to scan on a phone.
// The older generic serving choice stays routable for saved records, but it is
// intentionally not an option people see now that the three specific teams are clear.
const formInterests = INTERESTS.filter((interest) => !interest.formHidden);
const groups = formInterests.reduce<{ name: string; items: typeof formInterests }[]>((acc, interest) => {
	const group = acc.find((g) => g.name === interest.group) ?? (acc.push({ name: interest.group, items: [] }), acc[acc.length - 1]);
	group.items.push(interest);
	return acc;
}, []);
---

{isEmbed ? (
	<ConnectEmbed
		title="New Life | Connect Card"
		description="Tell us you're here, ask for prayer, or take a next step at New Life Grand Rapids."
	>
		<ConnectForm groups={groups} picked={picked} from={from} embed />
	</ConnectEmbed>
) : (
	<Interior
		title="New Life | Connect Card"
		description="Tell us you're here, ask for prayer, or take a next step at New Life Grand Rapids."
		kicker="Say hello"
		heading="Connect Card"
		lede="However you found us, we'd love to know you. Tell us a little and someone from our team will follow up."
	>
		<section class="section">
			<ConnectForm groups={groups} picked={picked} from={from} />
		</section>
	</Interior>
)}
