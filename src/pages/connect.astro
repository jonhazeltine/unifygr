---
import Interior from "../layouts/Interior.astro";
import { INTERESTS, interestById } from "../lib/connect/routing";
export const prerender = false;

// A link can land here with the reason already chosen — the tap page sends
// people straight to the Ambassador option. An unknown id just falls back to
// the first choice, so a stale link can never land on nothing.
const wanted = interestById(Astro.url.searchParams.get("interest") ?? "")?.id;
const from = Astro.url.searchParams.get("from")?.slice(0, 40) ?? "";
---

<Interior
	title="New Life | Connect Card"
	description="Tell us you're here, ask for prayer, or take a next step at New Life Grand Rapids."
	kicker="Say hello"
	heading="Connect Card"
	lede="However you found us, we'd love to know you. Tell us a little and someone from our team will follow up."
>
	<section class="section">
		<div class="container connect-wrap">
			<form class="connect-form" id="connect-form" novalidate>
				<div class="connect-row">
					<label class="field">
						<span>First name</span>
						<input name="firstName" type="text" autocomplete="given-name" required />
					</label>
					<label class="field">
						<span>Last name</span>
						<input name="lastName" type="text" autocomplete="family-name" required />
					</label>
				</div>

				<div class="connect-row">
					<label class="field">
						<span>Email</span>
						<input name="email" type="email" autocomplete="email" inputmode="email" />
					</label>
					<label class="field">
						<span>Phone</span>
						<input name="phone" type="tel" autocomplete="tel" inputmode="tel" />
					</label>
				</div>
				<p class="field-note">Either one is fine — we just need a way to reach you.</p>

				<label class="field">
					<span>City</span>
					<input name="city" type="text" autocomplete="address-level2" />
				</label>

				<fieldset class="field field--choices">
					<legend>What would you like from us?</legend>
					{INTERESTS.map((interest, i) => (
						<label class="choice">
							<input
								type="radio"
								name="interest"
								value={interest.id}
								checked={wanted ? interest.id === wanted : i === 0}
							/>
							<span>{interest.label}</span>
						</label>
					))}
				</fieldset>

				<label class="field">
					<span>Anything you'd like us to know</span>
					<textarea name="message" rows="5" placeholder="A prayer request, a question, or just how you found us."></textarea>
				</label>

				{from && <input type="hidden" name="source" value={`Website — ${from}`} />}

				{/* Not shown to people — only bots fill this in. */}
				<div class="connect-hp" aria-hidden="true">
					<label>Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
				</div>

				<p class="connect-error" id="connect-error" role="alert" hidden></p>

				<button class="button button--primary" type="submit" id="connect-submit">Send it</button>
				<p class="field-note">What you write here goes to our pastoral team, not anywhere public.</p>
			</form>

			<div class="connect-done" id="connect-done" hidden>
				<p class="eyebrow">Thank you</p>
				<h2>We've got it.</h2>
				<p>Someone from our team will reach out. If it's urgent, call the church office and ask for a pastor.</p>
			</div>
		</div>
	</section>
</Interior>

<style>
	.connect-wrap { max-width: 44rem; }
	.connect-form { display: grid; gap: 1.4rem; }
	.connect-row { display: grid; gap: 1.4rem; grid-template-columns: 1fr 1fr; }
	@media (max-width: 620px) { .connect-row { grid-template-columns: 1fr; } }

	.field { display: grid; gap: 0.5rem; }
	.field > span, .field legend { font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
	.field input[type="text"], .field input[type="email"], .field input[type="tel"], .field textarea {
		width: 100%;
		padding: 0.85rem 1rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--panel);
		color: var(--text);
		font: inherit;
	}
	.field textarea { resize: vertical; }
	.field input:focus-visible, .field textarea:focus-visible {
		outline: none;
		border-color: var(--gold);
		box-shadow: 0 0 0 3px var(--gold-soft);
	}
	.field-note { margin: -0.7rem 0 0; font-size: 0.85rem; color: var(--muted); }

	.field--choices { border: 1px solid var(--line); border-radius: 16px; padding: 1.2rem 1.3rem; background: var(--panel); }
	.field--choices legend { padding: 0 0.5rem; }
	.choice { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.42rem 0; cursor: pointer; }
	.choice input { margin-top: 0.28rem; accent-color: var(--gold); }
	.choice span { color: var(--text); }

	.connect-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

	.connect-error { margin: 0; color: var(--rose); }
	.connect-done { border: 1px solid var(--gold-soft); border-radius: 20px; padding: 2.5rem; background: var(--panel); }
	.connect-done h2 { margin: 0.4rem 0 0.8rem; }
	.connect-done p { color: var(--muted); }

	#connect-submit[disabled] { opacity: 0.6; cursor: progress; }
</style>

<script>
	const form = document.getElementById("connect-form") as HTMLFormElement | null;
	const done = document.getElementById("connect-done");
	const error = document.getElementById("connect-error") as HTMLParagraphElement | null;
	const submit = document.getElementById("connect-submit") as HTMLButtonElement | null;

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!error || !submit || !done) return;

		error.hidden = true;
		submit.disabled = true;
		submit.textContent = "Sending…";

		const payload = Object.fromEntries(new FormData(form).entries());

		try {
			const res = await fetch("/api/connect/submit", {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify(payload),
			});
			const data = await res.json().catch(() => ({}));
			if (!res.ok || !data.ok) throw new Error(data.error || "Something went wrong. Please try again.");
			form.hidden = true;
			done.hidden = false;
			done.scrollIntoView({ behavior: "smooth", block: "center" });
		} catch (err) {
			error.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
			error.hidden = false;
			submit.disabled = false;
			submit.textContent = "Send it";
		}
	});
</script>
